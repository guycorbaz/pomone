// Pomone — Tasks page.
//
// A single flat list of every task, newest planned date first
// (reverse-chronological), built by Rust (`list_agenda`). Each row is
// clickable and opens the shared task edit form. The date is tinted red for
// overdue rows (pending and past); completed rows are greyed out.

import { Palette, Theme, Card } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct AgendaRow {
    task-id: string,
    planned-on: string,
    label: string,
    color: color,
    completed: bool,
    overdue: bool,
    today: bool,
}

// A small status pill (e.g. "En retard", "Aujourd'hui").
component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    border-radius: Theme.radius-sm;
    background: root.tint;
    height: 18px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: Theme.space-xs;
        padding-right: Theme.space-xs;
        Text {
            text: root.label;
            color: Palette.text-on-primary;
            font-size: Theme.font-size-label;
            font-weight: Theme.font-weight-semibold;
            vertical-alignment: center;
        }
    }
}

// One clickable task row: colored type dot, label, status badge, planned date.
component AgendaTaskRow inherits Rectangle {
    in property <AgendaRow> task;
    in property <string> overdue-label;
    in property <string> today-label;
    callback clicked(string);

    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Palette.surface-alt : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.task.task-id); }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-md;

        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.task.color;
            opacity: root.task.completed ? 0.45 : 1.0;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.task.label;
            color: root.task.completed ? Palette.text-muted : Palette.text-primary;
            font-size: Theme.font-size-body;
            font-weight: Theme.font-weight-semibold;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.task.overdue: StatusBadge {
            label: root.overdue-label;
            tint: Palette.danger;
            y: (parent.height - self.height) / 2;
        }
        if root.task.today: StatusBadge {
            label: root.today-label;
            tint: Palette.primary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.task.planned-on;
            color: root.task.overdue ? Palette.danger
                 : root.task.completed ? Palette.text-muted
                 : Palette.text-secondary;
            font-size: Theme.font-size-label;
            font-weight: root.task.overdue ? Theme.font-weight-semibold : Theme.font-weight-regular;
            vertical-alignment: center;
        }
    }
}

export component AgendaPage inherits Rectangle {
    background: Palette.background;

    in property <string> title-text;
    in property <string> empty-text;
    in property <string> overdue-label;
    in property <string> today-label;
    in property <[AgendaRow]> rows;

    callback task-clicked(string);

    ScrollView {
        VerticalLayout {
            padding: Theme.space-2xl;
            spacing: Theme.space-xl;

            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: root.title-text;
                    color: Palette.primary;
                    font-size: Theme.font-size-h1;
                    font-weight: Theme.font-weight-bold;
                }
                Text {
                    text: "(\{root.rows.length})";
                    color: Palette.text-secondary;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.font-weight-semibold;
                    vertical-alignment: bottom;
                    horizontal-stretch: 1;
                }
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-sm;

                    if root.rows.length == 0: Text {
                        text: root.empty-text;
                        color: Palette.text-muted;
                        font-size: Theme.font-size-body;
                    }

                    for row in root.rows: AgendaTaskRow {
                        task: row;
                        overdue-label: root.overdue-label;
                        today-label: root.today-label;
                        clicked(id) => { root.task-clicked(id); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
