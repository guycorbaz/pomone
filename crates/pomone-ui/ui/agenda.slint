// Pomone — Tasks page.
//
// A single flat list of every task, newest planned date first
// (reverse-chronological), built by Rust (`list_agenda`). Clicking a row's
// label opens the shared task edit form. Each row also carries a ⋯ menu that
// settles the task in place (story 1.5): «Marquer fait» / «Abandonner…» when
// pending, «Corriger» when already done or skipped. The date is tinted red for
// overdue rows (pending and past); completed rows are greyed; skipped rows are
// struck through and carry a reason badge.

import { Palette, Theme, Card } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct AgendaRow {
    task-id: string,
    planned-on: string,
    label: string,
    color: color,
    completed: bool,
    skipped: bool,
    // Localized skip-reason label (e.g. "météo"); empty unless `skipped`.
    skip-reason: string,
    overdue: bool,
    today: bool,
}

// A small status pill (e.g. "En retard", "Aujourd'hui", "Abandonnée · météo").
component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    border-radius: Theme.radius-sm;
    background: root.tint;
    height: 18px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: Theme.space-xs;
        padding-right: Theme.space-xs;
        Text {
            text: root.label;
            color: Palette.text-on-primary;
            font-size: Theme.font-size-label;
            font-weight: Theme.font-weight-semibold;
            vertical-alignment: center;
        }
    }
}

// A single clickable row of the ⋯ context menu.
component MenuItem inherits Rectangle {
    in property <string> label;
    callback chosen();
    height: 32px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Palette.surface-alt : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        Text {
            text: root.label;
            color: Palette.text-primary;
            font-size: Theme.font-size-body;
            vertical-alignment: center;
        }
    }
}

// One task row: colored type dot, clickable label, status badge, planned date,
// and a ⋯ settle menu.
component AgendaTaskRow inherits Rectangle {
    in property <AgendaRow> task;
    in property <string> overdue-label;
    in property <string> today-label;
    in property <string> skipped-label;
    in property <string> menu-done-label;
    in property <string> menu-skip-label;
    in property <string> menu-correct-label;
    callback clicked(string);
    callback mark-done(string);
    callback skip-requested(string);
    callback reopen(string);

    property <bool> settled: root.task.completed || root.task.skipped;

    border-radius: Theme.radius-sm;
    background: rowtouch.has-hover ? Palette.surface-alt : transparent;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-md;

        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.task.color;
            opacity: root.settled ? 0.45 : 1.0;
            y: (parent.height - self.height) / 2;
        }

        // Clickable label. A skipped row is struck through with an overlaid line
        // (Slint Text has no strikethrough attribute).
        Rectangle {
            horizontal-stretch: 1;
            rowtouch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked(root.task.task-id); }
            }
            HorizontalLayout {
                label := Text {
                    text: root.task.label;
                    color: root.settled ? Palette.text-muted : Palette.text-primary;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.font-weight-semibold;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if root.task.skipped: Rectangle {
                height: 1px;
                width: min(label.preferred-width, parent.width);
                x: 0;
                y: parent.height / 2;
                background: Palette.text-muted;
            }
        }

        if root.task.skipped: StatusBadge {
            label: root.task.skip-reason == "" ? root.skipped-label
                 : root.skipped-label + " · " + root.task.skip-reason;
            tint: Palette.text-muted;
            y: (parent.height - self.height) / 2;
        }
        if root.task.overdue: StatusBadge {
            label: root.overdue-label;
            tint: Palette.danger;
            y: (parent.height - self.height) / 2;
        }
        if root.task.today: StatusBadge {
            label: root.today-label;
            tint: Palette.primary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.task.planned-on;
            color: root.task.overdue ? Palette.danger
                 : root.settled ? Palette.text-muted
                 : Palette.text-secondary;
            font-size: Theme.font-size-label;
            font-weight: root.task.overdue ? Theme.font-weight-semibold : Theme.font-weight-regular;
            vertical-alignment: center;
        }

        // ⋯ settle menu.
        Rectangle {
            width: 28px;
            y: (parent.height - self.height) / 2;
            height: 28px;
            border-radius: Theme.radius-sm;
            background: menutouch.has-hover ? Palette.surface : transparent;
            menutouch := TouchArea {
                mouse-cursor: pointer;
                clicked => { menu.show(); }
            }
            Text {
                text: "⋯";
                color: Palette.text-secondary;
                font-size: Theme.font-size-h2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            menu := PopupWindow {
                x: parent.width - 180px;
                y: parent.height + 2px;
                Rectangle {
                    width: 180px;
                    background: Palette.surface;
                    border-width: Theme.border-width;
                    border-color: Palette.border-strong;
                    border-radius: Theme.radius-md;
                    VerticalLayout {
                        padding: Theme.space-xs;
                        spacing: 0;
                        if !root.settled: MenuItem {
                            label: root.menu-done-label;
                            chosen => { menu.close(); root.mark-done(root.task.task-id); }
                        }
                        if !root.settled: MenuItem {
                            label: root.menu-skip-label;
                            chosen => { menu.close(); root.skip-requested(root.task.task-id); }
                        }
                        if root.settled: MenuItem {
                            label: root.menu-correct-label;
                            chosen => { menu.close(); root.reopen(root.task.task-id); }
                        }
                    }
                }
            }
        }
    }
}

export component AgendaPage inherits Rectangle {
    background: Palette.background;

    in property <string> title-text;
    in property <string> empty-text;
    in property <string> overdue-label;
    in property <string> today-label;
    in property <string> skipped-label;
    in property <string> menu-done-label;
    in property <string> menu-skip-label;
    in property <string> menu-correct-label;
    in property <[AgendaRow]> rows;

    callback task-clicked(string);
    callback mark-done(string);
    callback skip-requested(string);
    callback reopen(string);

    ScrollView {
        VerticalLayout {
            padding: Theme.space-2xl;
            spacing: Theme.space-xl;

            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: root.title-text;
                    color: Palette.primary;
                    font-size: Theme.font-size-h1;
                    font-weight: Theme.font-weight-bold;
                }
                Text {
                    text: "(\{root.rows.length})";
                    color: Palette.text-secondary;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.font-weight-semibold;
                    vertical-alignment: bottom;
                    horizontal-stretch: 1;
                }
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-sm;

                    if root.rows.length == 0: Text {
                        text: root.empty-text;
                        color: Palette.text-muted;
                        font-size: Theme.font-size-body;
                    }

                    for row in root.rows: AgendaTaskRow {
                        task: row;
                        overdue-label: root.overdue-label;
                        today-label: root.today-label;
                        skipped-label: root.skipped-label;
                        menu-done-label: root.menu-done-label;
                        menu-skip-label: root.menu-skip-label;
                        menu-correct-label: root.menu-correct-label;
                        clicked(id) => { root.task-clicked(id); }
                        mark-done(id) => { root.mark-done(id); }
                        skip-requested(id) => { root.skip-requested(id); }
                        reopen(id) => { root.reopen(id); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
