// Pomone — Locations (Lieux) screen.
//
// Left card lists every location as a flat, indent-by-depth tree. Right card
// has the form to add a new location (Kind / Name / Area / Parent / Notes).
//
// The Rust side flattens the hierarchy into pre-order `LocationItem`s with
// a `depth` field; the row indent is `depth × 24px`.

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader, ThemedLineEdit, ThemedComboBox } from "theme.slint";
import { ListView } from "std-widgets.slint";

export struct LocationItem {
    id: string,
    name: string,
    kind-label: string,
    area-label: string,
    dimensions-label: string,
    parent-label: string,
    full-path: string,
    depth: int,
    in-use: bool,
}

component LocationRowView inherits Card {
    in property <LocationItem> entry;
    in property <length> indent-step: 24px;
    in property <string> edit-text;
    in property <string> delete-text;
    in property <string> in-use-text;
    callback edit(string);
    callback delete(string);
    height: 84px;

    HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-md;

        // Indent based on depth — drawn as an empty Rectangle so the rest of
        // the row keeps the layout's stretch behaviour.
        Rectangle {
            width: entry.depth * root.indent-step;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: entry.name;
                color: Palette.text-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-semibold;
            }
            Text {
                text: entry.kind-label + " · " + entry.dimensions-label
                      + (entry.parent-label != "" ? "  ↳ " + entry.parent-label : "");
                color: Palette.text-muted;
                font-size: Theme.font-size-label;
            }
        }
        // Actions side by side so they fit the row height; the "in use" hint
        // sits to their left rather than stacked underneath.
        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: end;
            if entry.in-use: Text {
                text: in-use-text;
                color: Palette.text-secondary;
                font-size: Theme.font-size-label;
                vertical-alignment: center;
            }
            SecondaryButton {
                text: edit-text;
                clicked => { edit(entry.id); }
            }
            SecondaryButton {
                text: delete-text;
                // A location with child locations or plantings can't be
                // deleted (FK RESTRICT) — disable and explain.
                enabled: !entry.in-use;
                clicked => { delete(entry.id); }
            }
        }
    }
}

export component LocationsPage inherits Rectangle {
    background: Palette.background;

    // Header
    in property <string> title-text;

    // List
    in property <string> list-title;
    in property <string> empty-locations-text;
    in property <[LocationItem]> locations;

    // Form
    in property <string> form-section-title;
    in property <string> label-loc-name;
    in property <string> placeholder-loc-name;
    in property <string> label-loc-kind;
    in property <string> label-loc-length;
    in property <string> placeholder-loc-length;
    in property <string> label-loc-width;
    in property <string> placeholder-loc-width;
    in property <string> label-loc-parent;
    in property <string> label-loc-notes;
    in property <string> placeholder-loc-notes;
    in property <[string]> loc-kind-labels;
    in property <[string]> loc-parent-labels;
    in-out property <int> loc-kind-index: 0;
    in-out property <int> loc-parent-index: 0;
    in-out property <string> new-loc-name;
    in-out property <string> new-loc-length: "5";
    in-out property <string> new-loc-width: "2";
    in-out property <string> new-loc-notes;
    in property <string> create-loc-button-text;
    callback create-location();
    in property <string> location-delete-text;
    in property <string> location-in-use-text;
    in property <string> location-edit-text;
    in property <string> loc-form-section-edit;
    in property <string> loc-cancel-text;
    in property <string> loc-save-text;
    in property <bool> loc-is-edit-mode: false;
    callback edit-location(string);
    callback cancel-location-edit();
    callback delete-location(string);

    in property <string> status-text;
    in property <bool> status-is-error: false;

    VerticalLayout {
        padding: Theme.space-2xl;
        spacing: Theme.space-xl;

        // Screen title.
        Text {
            text: title-text;
            color: Palette.primary;
            font-size: Theme.font-size-h1;
            font-weight: Theme.font-weight-bold;
        }

        // Body — list on the left, form on the right
        HorizontalLayout {
            spacing: Theme.space-xl;
            vertical-stretch: 1;

            // -------- List card --------
            Card {
                horizontal-stretch: 2;
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-md;

                    SectionHeader { text: list-title; }

                    if locations.length == 0: Rectangle {
                        height: 80px;
                        Text {
                            text: empty-locations-text;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if locations.length > 0: list-area := Rectangle {
                        min-height: 200px;
                        preferred-height: 360px;
                        vertical-stretch: 1;
                        ListView {
                            for item in locations: LocationRowView {
                                entry: item;
                                edit-text: location-edit-text;
                                delete-text: location-delete-text;
                                in-use-text: location-in-use-text;
                                width: list-area.width;
                                edit(id) => { edit-location(id); }
                                delete(id) => { delete-location(id); }
                            }
                        }
                    }
                }
            }

            // -------- Form card --------
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-md;

                    SectionHeader { text: loc-is-edit-mode ? loc-form-section-edit : form-section-title; }

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-loc-name;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-loc-name;
                            placeholder-text: placeholder-loc-name;
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-loc-kind;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedComboBox {
                            model: loc-kind-labels;
                            current-index <=> loc-kind-index;
                            enabled: loc-kind-labels.length > 0;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-loc-length;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-loc-length;
                                placeholder-text: placeholder-loc-length;
                                input-type: decimal;
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-loc-width;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-loc-width;
                                placeholder-text: placeholder-loc-width;
                                input-type: decimal;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-loc-parent;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedComboBox {
                            model: loc-parent-labels;
                            current-index <=> loc-parent-index;
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-loc-notes;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-loc-notes;
                            placeholder-text: placeholder-loc-notes;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        PrimaryButton {
                            text: loc-is-edit-mode ? loc-save-text : create-loc-button-text;
                            enabled: loc-kind-labels.length > 0;
                            clicked => { create-location(); }
                        }
                        if loc-is-edit-mode: SecondaryButton {
                            text: loc-cancel-text;
                            clicked => { cancel-location-edit(); }
                        }
                    }
                }
            }
        }

        // Shared status line
        Text {
            text: status-text;
            color: status-is-error ? Palette.danger : Palette.success;
            font-size: Theme.font-size-label;
            wrap: word-wrap;
        }
    }
}
