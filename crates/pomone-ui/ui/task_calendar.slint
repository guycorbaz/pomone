                            DayCell { day: days[40]; min-height: 110px; horizontal-stretch: 1; min-width: 0; preferred-width: 0; task-clicked(tid) => { root.task-clicked(tid); } milestone-clicked(pid) => { root.milestone-clicked(pid); } pill-hover(h, lbl, x, y) => { root.handle-pill-hover(h, lbl, x, y); } task-drag-started(id, lbl, c, x, y) => { root.handle-drag-start(id, lbl, c, x, y); } task-drag-moved(x, y) => { root.track-drag(x, y); } task-drag-ended(x, y) => { root.handle-drag-end(x, y); } }
                            DayCell { day: days[41]; min-height: 110px; horizontal-stretch: 1; min-width: 0; preferred-width: 0; task-clicked(tid) => { root.task-clicked(tid); } milestone-clicked(pid) => { root.milestone-clicked(pid); } pill-hover(h, lbl, x, y) => { root.handle-pill-hover(h, lbl, x, y); } task-drag-started(id, lbl, c, x, y) => { root.handle-drag-start(id, lbl, c, x, y); } task-drag-moved(x, y) => { root.track-drag(x, y); } task-drag-ended(x, y) => { root.handle-drag-end(x, y); } }
                        }
                    }

                    // Floating ghost that follows the cursor while a pill is
                    // being dragged. Positioned in the day-grid's local frame
                    // (drag-x/drag-y), nudged so the cursor sits inside it.
                    // No TouchArea → it never intercepts the drag's pointer.
                    if root.dragging: Rectangle {
                        x: root.drag-x - 12px;
                        y: root.drag-y - 9px;
                        width: 130px;
                        height: 18px;
                        border-radius: Theme.radius-sm;
                        background: root.drag-color;
                        opacity: 0.9;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            Text {
                                text: "•";
                                color: Palette.text-on-primary;
                                font-size: Theme.font-size-label;
                                font-weight: Theme.font-weight-semibold;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.drag-label;
                                color: Palette.text-on-primary;
                                font-size: Theme.font-size-label;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // Hover tooltip — shows the entry's full (un-elided) label,
                    // anchored above the pill (below it near the grid top).
                    if root.tooltip-visible: Rectangle {
                        x: min(root.tooltip-x, grid-area.width - self.width);
                        y: root.tooltip-y > 40px ? root.tooltip-y - self.height - 3px
                                                 : root.tooltip-y + 20px;
                        background: Palette.text-primary;
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding: 6px;
                            Text {
                                text: root.tooltip-text;
                                color: Palette.surface;
                                font-size: Theme.font-size-label;
                                max-width: 228px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    SectionHeader { text: empty-state-text; visible: !any-tasks; }
                    Text {
                        text: hint-text;
                        color: Palette.text-secondary;
                        font-size: Theme.font-size-label;
                    }
                }
            }
        }
    }
}
