// Pomone — Task Calendar screen.
//
// Monthly view of operational tasks (semis, repiquage, récolte, désherbage…).
// Same 6×7 layout as the harvest Calendar — Rust builds a fixed 42-cell
// model so the grid renders identically every month. Each cell shows day
// number + up to three task pills, each colored by its `TaskType` color
// (Rust pushes the resolved hex string). Clicking a pill opens the task
// in the edit form (where the user can toggle completion, edit fields, or
// delete the task); the "+ Nouvelle tâche" button opens the form in
// creation mode.

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader, TooltipState } from "theme.slint";
import { TooltipCatalog } from "components/tooltip.slint";
import { ScrollView } from "std-widgets.slint";

// One entry on the unified calendar grid — either an editable task or a
// read-only crop-cycle milestone (issue #47). Rust decides which by setting
// `is-milestone`; the pill renders and behaves accordingly.
export struct TaskRow {
    // Stringified `TaskId` — emitted on click for tasks. Empty for milestones.
    task-id: string,
    // Stringified `PlantingId` — emitted on click for milestones so the host
    // can route to the planting. Empty for tasks.
    planting-id: string,
    // `true` → read-only milestone (outline style, no drag, click → planting).
    // `false` → editable task (filled style, draggable, click → edit form).
    is-milestone: bool,
    // 0..7 enum index of the milestone kind (sowing, harvest…); drives the
    // outline color. Only meaningful when `is-milestone`.
    milestone-kind: int,
    // Single-glyph badge shown on milestones (e.g. "■" for end-of-harvest).
    // Empty for tasks (which use •/✓).
    glyph: string,
    // Short text shown inside the pill ("Tomate Marmande · Semis" etc.).
    label: string,
    // Hex color of the task's TaskType (e.g. "#3C6E47"). Ignored for milestones.
    color: color,
    // `true` once the task carries a completed_on date. Renders with reduced
    // opacity + a checkmark glyph so users see at a glance what's done.
    completed: bool,
}

/// One filter chip for the per-category toggle row above the calendar.
/// Rust pushes one chip per `TaskCategory` (always 8), pre-resolved color
/// (first type that uses that category) and localized label.
export struct TaskCategoryChip {
    // Stable enum key ("sow", "transplant", …) — sent back on click so
    // Rust can toggle the filter without label translation roundtrips.
    key: string,
    // Localized category label ("Semis", "Sowing", …).
    label: string,
    // Resolved color of the chip swatch.
    color: color,
    // `true` when the filter currently includes this category.
    selected: bool,
}

export struct TaskCalendarDay {
    // 1..=31, or 0 for an empty leading/trailing cell.
    day-number: int,
    in-current-month: bool,
    is-today: bool,
    // Public holiday of the configured region (#35): greys the cell and
    // shows the (already localized) name under the day number.
    is-holiday: bool,
    holiday-name: string,
    tasks: [TaskRow],
}

// A clickable pill rendering one unified-calendar entry.
//
// **Tasks** (`is-milestone == false`): filled with the TaskType color. A short
// press-release opens the edit form; a press-and-drag starts a reschedule
// gesture — the host paints a floating ghost and, on release inside the grid,
// drops the task on the day under the pointer. Coordinates are reported in
// absolute (window) space so the page can hit-test regardless of nesting.
//
// **Milestones** (`is-milestone == true`): read-only crop-cycle events, drawn
// as an outline (transparent fill, colored border by kind) to set them apart
// from actionable tasks. A click routes to the planting; no drag.
component TaskPill inherits Rectangle {
    in property <TaskRow> task;
    callback clicked(string);
    // Emitted when a read-only milestone is clicked — carries the planting id.
    callback milestone-clicked(string);
    // Emitted once the pointer has moved past the drag threshold while
    // pressed. Carries the task id + its label/color so the page can paint
    // the ghost, plus the absolute pointer position. Tasks only.
    callback drag-started(string, string, color, length, length);
    // Pointer moved while dragging — absolute position.
    callback drag-moved(length, length);
    // Pointer released while dragging — absolute position.
    callback drag-ended(length, length);
    // Hover entered/left. Carries the full label + the pill's absolute
    // top-left so the page can anchor a tooltip (the pill itself elides).
    callback hover-changed(bool, string, length, length);

    // Press / drag bookkeeping. `press-x/y` are relative to the pill so the
    // threshold check is local; everything reported upward is absolute.
    property <bool> pressed: false;
    property <bool> did-drag: false;
    property <length> press-x;
    property <length> press-y;

    // Outline color for milestones, mirroring the standalone calendar's
    // per-kind palette (kept in sync with `calendar.slint`).
    property <color> kind-color:
          task.milestone-kind == 0 ? Palette.primary           // Sowing
        : task.milestone-kind == 1 ? Palette.primary-hover     // Transplanting
        : task.milestone-kind == 2 ? Palette.accent            // HarvestStart
        : task.milestone-kind == 3 ? Palette.accent-pressed    // HarvestEnd
        : task.milestone-kind == 4 ? Palette.primary-pressed   // Establishment
        : task.milestone-kind == 5 ? Palette.danger            // Removal
        : task.milestone-kind == 6 ? Palette.warning           // BudBreak
        :                            Palette.accent-hover;      // Flowering

    height: 18px;
    min-width: 0;
    border-radius: Theme.radius-sm;
    clip: true;
    // Milestones: outline (transparent fill + colored border). Tasks: filled.
    background: task.is-milestone ? transparent : task.color;
    border-width: task.is-milestone ? 1px : 0;
    border-color: root.kind-color;
    // Completed = dimmed so done items stay visible but visually retreat.
    // The dragged pill itself fades to a placeholder while the ghost flies.
    opacity: root.did-drag ? 0.3
           : task.completed ? 0.45
           : (touch.has-hover ? 0.85 : 1.0);
    animate opacity { duration: Theme.transition-fast; }

    touch := TouchArea {
        mouse-cursor: task.is-milestone ? MouseCursor.pointer
                    : root.pressed ? MouseCursor.grabbing : MouseCursor.grab;

        // Tooltip on hover — suppressed while dragging this pill.
        changed has-hover => {
            if (self.has-hover && !root.pressed) {
                root.hover-changed(true, task.label,
                                   self.absolute-position.x, self.absolute-position.y);
            } else {
                root.hover-changed(false, "", 0, 0);
            }
        }

        pointer-event(ev) => {
            if (ev.button != PointerEventButton.left) {
                return;
            }
            // Milestones are read-only: a plain click routes to the planting,
            // no drag bookkeeping.
            if (task.is-milestone) {
                if (ev.kind == PointerEventKind.up) {
                    root.milestone-clicked(task.planting-id);
                }
                return;
            }
            if (ev.kind == PointerEventKind.down) {
                root.pressed = true;
                root.did-drag = false;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
            } else if (ev.kind == PointerEventKind.up) {
                if (root.did-drag) {
                    root.drag-ended(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                } else {
                    root.clicked(task.task-id);
                }
                root.pressed = false;
                root.did-drag = false;
            }
        }

        moved => {
            // No drag for read-only milestones.
            if (task.is-milestone || !root.pressed) {
                return;
            }
            if (!root.did-drag
                && ((self.mouse-x - root.press-x).abs() > 4px
                    || (self.mouse-y - root.press-y).abs() > 4px)) {
                root.did-drag = true;
                root.drag-started(task.task-id, task.label, task.color,
                                  self.absolute-position.x + self.mouse-x,
                                  self.absolute-position.y + self.mouse-y);
            }
            if (root.did-drag) {
                root.drag-moved(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
            }
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;
            Text {
                text: task.is-milestone ? task.glyph : (task.completed ? "✓" : "•");
                color: task.is-milestone ? root.kind-color : Palette.text-on-primary;
                font-size: Theme.font-size-label;
                font-weight: Theme.font-weight-semibold;
                vertical-alignment: center;
            }
            Text {
                text: task.label;
                color: task.is-milestone ? root.kind-color : Palette.text-on-primary;
                font-size: Theme.font-size-label;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

// A single category filter chip. Click toggles the per-category filter
// via the host; the visual state mirrors `chip.selected` (full opacity +
// strong border when on, reduced opacity + thin border when off).
component CategoryChipView inherits Rectangle {
    in property <TaskCategoryChip> chip;
    // Optional hover-help text; empty = no tooltip (see TooltipState).
    in property <string> tip;
    callback clicked(string);

    height: 30px;
    min-width: 0;
    // Pill-shaped like Qrop's ChoiceChip.
    border-radius: Theme.radius-pill;
    border-width: chip.selected ? 2px : Theme.border-width;
    border-color: chip.selected ? chip.color : Palette.border;
    background: chip.selected ? chip.color : Palette.surface;
    opacity: chip.selected ? 1.0 : (touch.has-hover ? 0.95 : 0.55);
    animate opacity, background, border-color { duration: Theme.transition-fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                TooltipState.hide(root.tip);
            }
        }
        clicked => { root.clicked(chip.key); }

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            spacing: Theme.space-xs;
            alignment: center;

            Text {
                text: chip.label;
                color: chip.selected ? Palette.text-on-primary : Palette.text-secondary;
                font-size: Theme.font-size-label;
                font-weight: chip.selected ? Theme.font-weight-semibold : Theme.font-weight-medium;
                vertical-alignment: center;
            }
        }
    }
}

// A standalone on/off chip (used for the milestone master toggle). Mirrors
// CategoryChipView's look but is driven by a plain bool + label.
component ToggleChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <color> tint;
    // Optional hover-help text; empty = no tooltip (see TooltipState).
    in property <string> tip;
    callback clicked();

    height: 30px;
    min-width: 0;
    // Pill-shaped like Qrop's ChoiceChip.
    border-radius: Theme.radius-pill;
    border-width: selected ? 2px : Theme.border-width;
    border-color: selected ? tint : Palette.border;
    background: selected ? tint : Palette.surface;
    opacity: selected ? 1.0 : (touch.has-hover ? 0.95 : 0.55);
    animate opacity, background, border-color { duration: Theme.transition-fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                TooltipState.hide(root.tip);
            }
        }
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            alignment: center;
            Text {
                text: root.label;
                color: root.selected ? Palette.text-on-primary : Palette.text-secondary;
                font-size: Theme.font-size-label;
                font-weight: root.selected ? Theme.font-weight-semibold : Theme.font-weight-medium;
                vertical-alignment: center;
            }
        }
    }
}

component DayCell inherits Rectangle {
    in property <TaskCalendarDay> day;
    callback task-clicked(string);
    // A read-only milestone pill was clicked — carries the planting id.
    callback milestone-clicked(string);
    // Hover enter/leave on a pill — forwarded up to drive the page tooltip.
    callback pill-hover(bool, string, length, length);
    // Forwarded straight up from the pills so the page owns all drag state.
    callback task-drag-started(string, string, color, length, length);
    callback task-drag-moved(length, length);
    callback task-drag-ended(length, length);

    min-width: 0;
    clip: true;
    border-width: Theme.border-width;
    border-color: Palette.border;
    border-radius: Theme.radius-sm;
    // Holidays render like out-of-month days (greyed, #35) — but today's
    // highlight always wins so "where am I" stays readable.
    background: day.is-today ? Palette.surface-alt
              : day.in-current-month && !day.is-holiday ? Palette.surface
              :                        Palette.background;

    VerticalLayout {
        padding: Theme.space-xs;
        spacing: 2px;

        Text {
            text: day.day-number > 0 ? day.day-number : "";
            color: day.in-current-month ? Palette.text-primary : Palette.text-muted;
            font-size: Theme.font-size-label;
            font-weight: day.is-today ? Theme.font-weight-bold : Theme.font-weight-medium;
            horizontal-alignment: right;
        }

        if day.is-holiday && day.holiday-name != "": Text {
            text: day.holiday-name;
            color: Palette.text-muted;
            font-size: Theme.font-size-label;
            font-italic: true;
            overflow: elide;
        }

        // Show up to 3 task pills; collapse the rest into a "+N" line so the
        // cell stays a predictable height.
        for t[i] in day.tasks: Rectangle {
            visible: i < 3;
            height: i < 3 ? 18px : 0;
            min-width: 0;
            TaskPill {
                task: t;
                width: parent.width;
                height: 18px;
                clicked(tid) => { root.task-clicked(tid); }
                milestone-clicked(pid) => { root.milestone-clicked(pid); }
                hover-changed(h, lbl, x, y) => { root.pill-hover(h, lbl, x, y); }
                drag-started(id, lbl, col, x, y) => { root.task-drag-started(id, lbl, col, x, y); }
                drag-moved(x, y) => { root.task-drag-moved(x, y); }
                drag-ended(x, y) => { root.task-drag-ended(x, y); }
            }
        }
        if day.tasks.length > 3: Text {
            text: "+" + (day.tasks.length - 3);
            color: Palette.text-muted;
            font-size: Theme.font-size-label;
        }

        Rectangle { vertical-stretch: 1; }
    }
}

export component TaskCalendarPage inherits Rectangle {
    background: Palette.background;

    in property <string> title-text;
    in property <string> month-label;
    // Legend + counts shown on the month bar (issue #47).
    in property <string> summary-text;          // "12 tâches · 3 jalons"
    in property <string> legend-task-label;      // "Tâche"
    in property <string> legend-milestone-label; // "Jalon"
    in property <string> prev-button-text;
    in property <string> next-button-text;
    in property <string> today-button-text;
    in property <string> empty-state-text;
    in property <string> hint-text;          // "Cliquez sur une tâche pour la modifier."
    in property <string> new-task-button-text;  // "+ Nouvelle tâche"
    in property <string> manage-types-button-text;  // "Gérer les types"
    in property <string> filter-hint-text;         // "Filtrer par type :"
    in property <string> filter-all-button-text;   // "Tout afficher"
    in property <string> milestone-filter-label;   // "Jalons de culture"

    in property <[string]> weekday-labels;
    in property <[TaskCalendarDay]> days;
    in property <[TaskCategoryChip]> filter-chips;
    in property <bool> any-tasks;
    in property <bool> show-milestones;

    callback prev-month();
    callback next-month();
    callback go-today();
    callback task-clicked(string);
    // A read-only milestone pill was clicked — carries the planting id so the
    // host can route to that planting.
    callback milestone-clicked(string);
    callback new-task-clicked();
    callback manage-types-clicked();
    callback toggle-category(string);
    callback select-all-categories();
    // Master toggle for the crop-cycle milestone family (second filter group).
    callback toggle-milestones();
    // A task pill was dropped on the day grid. Carries the task id and the
    // pointer's release position relative to the grid plus the per-cell
    // pitch (cell size + spacing) on each axis, so the host resolves which
    // of the 42 cells received the drop without duplicating grid geometry.
    callback task-dropped(string, length, length, length, length);

    // --- Drag state (owned here; pills only report pointer events) ---
    property <bool> dragging: false;
    property <string> drag-task-id;
    property <string> drag-label;
    property <color> drag-color;
    // Pointer position expressed relative to the day-grid's top-left.
    property <length> drag-x;
    property <length> drag-y;

    // --- Hover tooltip state (relative to the day grid) ---
    property <bool> tooltip-visible: false;
    property <string> tooltip-text;
    property <length> tooltip-x;
    property <length> tooltip-y;

    // A pill's hover changed: show/hide the tooltip anchored above it.
    function handle-pill-hover(hovering: bool, label: string, ax: length, ay: length) {
        if (hovering && !root.dragging) {
            root.tooltip-text = label;
            root.tooltip-x = ax - grid-area.absolute-position.x;
            root.tooltip-y = ay - grid-area.absolute-position.y;
            root.tooltip-visible = true;
        } else {
            root.tooltip-visible = false;
        }
    }

    // Translate an absolute (window-space) pointer position into the day
    // grid's local frame and update the ghost position.
    function track-drag(ax: length, ay: length) {
        root.drag-x = ax - grid-area.absolute-position.x;
        root.drag-y = ay - grid-area.absolute-position.y;
    }

    // A pill crossed the drag threshold: arm the ghost.
    function handle-drag-start(id: string, lbl: string, c: color, ax: length, ay: length) {
        root.drag-task-id = id;
        root.drag-label = lbl;
        root.drag-color = c;
        root.track-drag(ax, ay);
        root.dragging = true;
    }

    // Pill released. If the drop landed inside the grid, hand the host the
    // task id, the drop point, and the per-cell pitch on each axis so it can
    // resolve the target day. Releasing outside the grid silently cancels.
    function handle-drag-end(ax: length, ay: length) {
        root.track-drag(ax, ay);
        if (root.drag-x >= 0 && root.drag-x <= grid-area.width
            && root.drag-y >= 0 && root.drag-y <= grid-area.height) {
            root.task-dropped(root.drag-task-id, root.drag-x, root.drag-y,
                              (grid-area.width + Theme.space-xs) / 7,
                              (grid-area.height + Theme.space-xs) / 6);
        }
        root.dragging = false;
    }

    ScrollView {
        VerticalLayout {
            padding: Theme.space-2xl;
            spacing: Theme.space-xl;

            // Header
            HorizontalLayout {
                spacing: Theme.space-md;
                Text {
                    text: title-text;
                    color: Palette.primary;
                    font-size: Theme.font-size-h1;
                    font-weight: Theme.font-weight-bold;
                    horizontal-stretch: 1;
                }
                PrimaryButton { text: new-task-button-text; tip: TooltipCatalog.calendar-new-task; clicked => { new-task-clicked(); } }
                SecondaryButton { text: manage-types-button-text; tip: TooltipCatalog.calendar-manage-types; clicked => { manage-types-clicked(); } }
                SecondaryButton { text: prev-button-text; tip: TooltipCatalog.calendar-prev; clicked => { prev-month(); } }
                SecondaryButton { text: today-button-text; tip: TooltipCatalog.calendar-today; clicked => { go-today(); } }
                SecondaryButton { text: next-button-text; tip: TooltipCatalog.calendar-next; clicked => { next-month(); } }
            }

            // Filter chips — one per TaskCategory. Rust pushes the full set
            // (always 8 today) with the resolved color and selected state.
            if filter-chips.length > 0: Card {
                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        alignment: start;
                        Text {
                            text: filter-hint-text;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        SecondaryButton {
                            text: filter-all-button-text;
                            tip: TooltipCatalog.calendar-filter-all;
                            clicked => { select-all-categories(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        alignment: start;
                        for chip in filter-chips: CategoryChipView {
                            chip: chip;
                            tip: TooltipCatalog.calendar-filter-chip;
                            clicked(k) => { toggle-category(k); }
                        }
                    }

                    // Second filter group: a master toggle for the crop-cycle
                    // milestone family (independent of the task categories).
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        alignment: start;
                        ToggleChip {
                            label: milestone-filter-label;
                            selected: show-milestones;
                            tint: Palette.accent;
                            tip: TooltipCatalog.calendar-milestones;
                            clicked => { toggle-milestones(); }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: month-label;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-h2;
                            font-weight: Theme.font-weight-semibold;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        // Legend: filled swatch = task, outline swatch = milestone.
                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            alignment: center;
                            Rectangle {
                                width: 14px;
                                height: 10px;
                                border-radius: Theme.radius-sm;
                                background: Palette.primary;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: legend-task-label;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            alignment: center;
                            Rectangle {
                                width: 14px;
                                height: 10px;
                                border-radius: Theme.radius-sm;
                                background: transparent;
                                border-width: 1px;
                                border-color: Palette.accent;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: legend-milestone-label;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: summary-text;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            vertical-alignment: center;
                        }
                    }

                    GridLayout {
                        spacing: Theme.space-xs;
                        Row {
                            for wd in weekday-labels: Text {
                                text: wd;
                                color: Palette.text-muted;
                                font-size: Theme.font-size-label;
                                font-weight: Theme.font-weight-semibold;
                                horizontal-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0;
                            }
                        }
                    }

                    grid-area := Rectangle {
                    GridLayout {
                        spacing: Theme.space-xs;
                        Row {
