// Pomone — Cultures (Crops) + Varieties master-detail screen.
//
// Left card lists Crops; clicking a row sets selected-crop-index, which the
// Rust side observes (via a changed callback on the property is not needed —
// we drive the data refresh from the user's row click).
//
// Right card lists Varieties of the currently selected Crop, plus a form to
// add a new annual variety. A separate form below the Crops list adds a new
// annual crop.

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader, ThemedLineEdit, ThemedComboBox } from "theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";

export struct CropRow {
    id: string,
    name: string,
    family-label: string,
    lifespan-label: string,
    pruning-label: string,
    variety-count: int,
    is-annual: bool,
    in-use: bool,
}

export struct VarietyRow {
    id: string,
    name: string,
    description: string,
    profile-label: string,
    in-use: bool,
}

// A single row in the Crops list. Highlights itself when selected.
component CropRowView inherits Rectangle {
    in property <CropRow> entry;
    in property <bool> selected;
    in property <string> edit-text;
    in property <string> delete-text;
    in property <string> in-use-text;
    callback clicked();
    callback edit(string);
    callback delete(string);

    height: 84px;
    background: selected ? Palette.surface-alt
                : touch.has-hover ? Palette.surface-alt
                : Palette.surface;
    border-color: selected ? Palette.primary : Palette.border;
    border-width: selected ? 2px : Theme.border-width;
    border-radius: Theme.radius-md;
    animate background, border-color { duration: Theme.transition-fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        VerticalLayout {
            padding: Theme.space-md;
            spacing: 2px;

            HorizontalLayout {
                spacing: Theme.space-md;
                Text {
                    text: entry.name;
                    color: Palette.text-primary;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.font-weight-semibold;
                    horizontal-stretch: 1;
                }
                Text {
                    text: entry.variety-count + " var.";
                    color: Palette.primary;
                    font-size: Theme.font-size-label;
                    font-weight: Theme.font-weight-semibold;
                    vertical-alignment: center;
                }
                SecondaryButton {
                    text: edit-text;
                    clicked => { edit(entry.id); }
                }
                SecondaryButton {
                    text: delete-text;
                    // Deletion is blocked while a variety of this crop is
                    // planted (FK); show why and disable the control.
                    enabled: !entry.in-use;
                    clicked => { delete(entry.id); }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;
                Text {
                    text: entry.family-label
                          + " · " + entry.lifespan-label + " · " + entry.pruning-label;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-label;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if entry.in-use: Text {
                    text: in-use-text;
                    color: Palette.text-secondary;
                    font-size: Theme.font-size-label;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component VarietyRowView inherits Card {
    in property <VarietyRow> entry;
    in property <string> delete-text;
    in property <string> in-use-text;
    callback delete(string);
    height: 96px;

    HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-md;
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: entry.name;
                color: Palette.text-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-semibold;
            }
            Text {
                text: entry.profile-label;
                color: Palette.text-muted;
                font-size: Theme.font-size-label;
            }
            if entry.description != "": Text {
                text: entry.description;
                color: Palette.text-secondary;
                font-size: Theme.font-size-label;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-xs;
            SecondaryButton {
                text: delete-text;
                enabled: !entry.in-use;
                clicked => { delete(entry.id); }
            }
            if entry.in-use: Text {
                text: in-use-text;
                color: Palette.text-secondary;
                font-size: Theme.font-size-label;
                horizontal-alignment: center;
            }
        }
    }
}

export component CulturesPage inherits Rectangle {
    background: Palette.background;

    // Header
    in property <string> title-text;

    // Crops side
    in property <string> crops-title;
    in property <string> empty-crops-text;
    in property <[CropRow]> crops;
    in-out property <int> selected-crop-index: -1;

    in property <string> new-crop-section;
    in property <string> label-crop-name;
    in property <string> placeholder-crop-name;
    in property <string> label-crop-latin;
    in property <string> placeholder-crop-latin;
    in property <string> label-family;
    in property <[string]> family-labels;
    in-out property <int> family-index: 0;
    in-out property <string> new-crop-name;
    in-out property <string> new-crop-latin;
    // Lifespan kind: 0 = Annual, 1 = Pluriannual single cycle,
    // 2 = Pluriannual recurring. Rust resolves the index back to the enum.
    in property <string> label-lifespan;
    in property <[string]> lifespan-labels;
    in-out property <int> new-crop-lifespan-index: 0;
    // Pluriannual extras (visible conditionally based on lifespan index).
    in property <string> label-lifespan-years;
    in property <string> placeholder-lifespan-years;
    in-out property <string> new-crop-lifespan-years: "30";
    in property <string> label-years-to-first-yield;
    in property <string> placeholder-years-to-first-yield;
    in-out property <string> new-crop-years-to-first-yield: "3";
    // Pruning season: 0 = None, 1 = Winter, 2 = Summer, 3 = Both.
    in property <string> label-pruning;
    in property <[string]> pruning-labels;
    in-out property <int> new-crop-pruning-index: 0;
    in property <string> create-crop-button-text;
    callback create-crop();

    // Crop edit / delete
    in property <string> crop-edit-text;
    in property <string> crop-delete-text;
    in property <string> crop-in-use-text;
    in property <string> crop-form-section-edit;
    in property <string> crop-cancel-text;
    in property <string> crop-save-text;
    // True while the crop form edits an existing crop (set by Rust). Drives the
    // form title, the submit button label, and the Cancel button.
    in property <bool> crop-is-edit-mode: false;
    callback edit-crop(string);
    callback delete-crop(string);
    callback cancel-crop-edit();

    // Varieties side
    in property <string> varieties-title;
    in property <string> empty-varieties-text;
    in property <string> no-crop-selected-text;
    in property <[VarietyRow]> varieties;

    in property <string> new-variety-section;
    in property <string> new-variety-section-pluriannual;
    in property <string> label-variety-name;
    in property <string> placeholder-variety-name;
    in property <string> label-variety-description;
    in property <string> placeholder-variety-description;
    // True when the selected crop is annual; drives which form panel shows.
    in property <bool> selected-crop-is-annual: true;
    // Annual variety form fields.
    in property <string> label-dtt;
    in property <string> label-dtm;
    in property <string> label-window;
    in property <string> placeholder-dtt;
    in property <string> placeholder-dtm;
    in property <string> placeholder-window;
    in-out property <string> new-variety-name;
    in-out property <string> new-variety-description;
    in-out property <string> new-variety-dtt: "35";
    in-out property <string> new-variety-dtm: "70";
    in-out property <string> new-variety-window: "60";
    // Pluriannual variety form fields.
    in property <string> label-bud-break-doy;
    in property <string> label-flowering-doy;
    in property <string> label-harvest-start-doy;
    in property <string> label-harvest-end-doy;
    in property <string> label-yield-kg;
    in property <string> placeholder-bud-break-doy;
    in property <string> placeholder-flowering-doy;
    in property <string> placeholder-harvest-start-doy;
    in property <string> placeholder-harvest-end-doy;
    in property <string> placeholder-yield-kg;
    in-out property <string> new-variety-bud-break-doy;
    in-out property <string> new-variety-flowering-doy;
    in-out property <string> new-variety-harvest-start-doy: "220";
    in-out property <string> new-variety-harvest-end-doy: "280";
    in-out property <string> new-variety-yield-kg;
    in property <string> create-variety-button-text;
    callback create-variety();
    in property <string> variety-delete-text;
    in property <string> variety-in-use-text;
    callback delete-variety(string);

    // Shared status line at the bottom
    in property <string> status-text;
    in property <bool> status-is-error: false;

    callback select-crop(int);

    // The cultures page stacks a title, two large master-detail cards with
    // ListViews and full create-crop / create-variety forms — easy to push
    // the bottom off-screen on smaller windows. Wrap in ScrollView so the
    // create forms stay reachable.
    ScrollView {
        VerticalLayout {
        padding: Theme.space-2xl;
        spacing: Theme.space-xl;

        // Screen title.
        Text {
            text: title-text;
            color: Palette.primary;
            font-size: Theme.font-size-h1;
            font-weight: Theme.font-weight-bold;
        }

        // Master-detail body
        HorizontalLayout {
            spacing: Theme.space-xl;
            vertical-stretch: 1;

            // -------- Crops card --------
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-md;

                    SectionHeader { text: crops-title; }

                    if crops.length == 0: Rectangle {
                        height: 80px;
                        Text {
                            text: empty-crops-text;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if crops.length > 0: crop-list := Rectangle {
                        min-height: 160px;
                        preferred-height: 280px;
                        vertical-stretch: 1;
                        ListView {
                            for crop[idx] in crops: CropRowView {
                                entry: crop;
                                selected: idx == selected-crop-index;
                                edit-text: crop-edit-text;
                                delete-text: crop-delete-text;
                                in-use-text: crop-in-use-text;
                                width: crop-list.width;
                                clicked => { select-crop(idx); }
                                edit(id) => { edit-crop(id); }
                                delete(id) => { delete-crop(id); }
                            }
                        }
                    }

                    Rectangle { height: Theme.space-xs; background: Palette.border; }
                    SectionHeader { text: crop-is-edit-mode ? crop-form-section-edit : new-crop-section; }

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-crop-name;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-crop-name;
                            placeholder-text: placeholder-crop-name;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-crop-latin;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-crop-latin;
                            placeholder-text: placeholder-crop-latin;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-family;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedComboBox {
                                model: family-labels;
                                current-index <=> family-index;
                                enabled: family-labels.length > 0;
                            }
                        }
                    }
                    // Lifespan + pruning dropdowns.
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-lifespan;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedComboBox {
                                model: lifespan-labels;
                                current-index <=> new-crop-lifespan-index;
                                enabled: lifespan-labels.length > 0;
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-pruning;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedComboBox {
                                model: pruning-labels;
                                current-index <=> new-crop-pruning-index;
                                enabled: pruning-labels.length > 0;
                            }
                        }
                    }
                    // Pluriannual extras — shown only when a pluri lifespan is picked.
                    if new-crop-lifespan-index > 0: HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-lifespan-years;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-crop-lifespan-years;
                                placeholder-text: placeholder-lifespan-years;
                                input-type: number;
                            }
                        }
                        // Recurring only — show "years to first yield".
                        if new-crop-lifespan-index == 2: VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-years-to-first-yield;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-crop-years-to-first-yield;
                                placeholder-text: placeholder-years-to-first-yield;
                                input-type: number;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        PrimaryButton {
                            text: crop-is-edit-mode ? crop-save-text : create-crop-button-text;
                            enabled: family-labels.length > 0;
                            clicked => { create-crop(); }
                        }
                        if crop-is-edit-mode: SecondaryButton {
                            text: crop-cancel-text;
                            clicked => { cancel-crop-edit(); }
                        }
                    }
                }
            }

            // -------- Varieties card --------
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-md;

                    SectionHeader { text: varieties-title; }

                    if selected-crop-index < 0: Rectangle {
                        height: 80px;
                        Text {
                            text: no-crop-selected-text;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if selected-crop-index >= 0 && varieties.length == 0: Rectangle {
                        height: 80px;
                        Text {
                            text: empty-varieties-text;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if selected-crop-index >= 0 && varieties.length > 0: var-list := Rectangle {
                        min-height: 160px;
                        preferred-height: 280px;
                        vertical-stretch: 1;
                        ListView {
                            for v in varieties: VarietyRowView {
                                entry: v;
                                delete-text: variety-delete-text;
                                in-use-text: variety-in-use-text;
                                width: var-list.width;
                                delete(id) => { delete-variety(id); }
                            }
                        }
                    }

                    Rectangle { height: Theme.space-xs; background: Palette.border; }
                    SectionHeader { text: selected-crop-is-annual ? new-variety-section : new-variety-section-pluriannual; }

                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-variety-name;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-variety-name;
                            placeholder-text: placeholder-variety-name;
                            enabled: selected-crop-index >= 0;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: label-variety-description;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-variety-description;
                            placeholder-text: placeholder-variety-description;
                            enabled: selected-crop-index >= 0;
                        }
                    }
                    // Annual variety form (DTT/DTM/window).
                    if selected-crop-is-annual: HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-dtt;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-variety-dtt;
                                placeholder-text: placeholder-dtt;
                                input-type: number;
                                enabled: selected-crop-index >= 0;
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-dtm;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-variety-dtm;
                                placeholder-text: placeholder-dtm;
                                input-type: number;
                                enabled: selected-crop-index >= 0;
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            horizontal-stretch: 1;
                            Text {
                                text: label-window;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-variety-window;
                                placeholder-text: placeholder-window;
                                input-type: number;
                                enabled: selected-crop-index >= 0;
                            }
                        }
                    }
                    // Pluriannual variety form (DOY phenology + yield).
                    if !selected-crop-is-annual: VerticalLayout {
                        spacing: Theme.space-md;
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            VerticalLayout {
                                spacing: Theme.space-xs;
                                horizontal-stretch: 1;
                                Text {
                                    text: label-bud-break-doy;
                                    color: Palette.text-secondary;
                                    font-size: Theme.font-size-label;
                                }
                                ThemedLineEdit {
                                    text <=> new-variety-bud-break-doy;
                                    placeholder-text: placeholder-bud-break-doy;
                                    input-type: number;
                                    enabled: selected-crop-index >= 0;
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.space-xs;
                                horizontal-stretch: 1;
                                Text {
                                    text: label-flowering-doy;
                                    color: Palette.text-secondary;
                                    font-size: Theme.font-size-label;
                                }
                                ThemedLineEdit {
                                    text <=> new-variety-flowering-doy;
                                    placeholder-text: placeholder-flowering-doy;
                                    input-type: number;
                                    enabled: selected-crop-index >= 0;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            VerticalLayout {
                                spacing: Theme.space-xs;
                                horizontal-stretch: 1;
                                Text {
                                    text: label-harvest-start-doy;
                                    color: Palette.text-secondary;
                                    font-size: Theme.font-size-label;
                                }
                                ThemedLineEdit {
                                    text <=> new-variety-harvest-start-doy;
                                    placeholder-text: placeholder-harvest-start-doy;
                                    input-type: number;
                                    enabled: selected-crop-index >= 0;
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.space-xs;
                                horizontal-stretch: 1;
                                Text {
                                    text: label-harvest-end-doy;
                                    color: Palette.text-secondary;
                                    font-size: Theme.font-size-label;
                                }
                                ThemedLineEdit {
                                    text <=> new-variety-harvest-end-doy;
                                    placeholder-text: placeholder-harvest-end-doy;
                                    input-type: number;
                                    enabled: selected-crop-index >= 0;
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: label-yield-kg;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> new-variety-yield-kg;
                                placeholder-text: placeholder-yield-kg;
                                input-type: decimal;
                                enabled: selected-crop-index >= 0;
                            }
                        }
                    }
                    PrimaryButton {
                        text: create-variety-button-text;
                        enabled: selected-crop-index >= 0;
                        clicked => { create-variety(); }
                    }
                }
            }
        }

        // Shared status line
        Text {
            text: status-text;
            color: status-is-error ? Palette.danger : Palette.success;
            font-size: Theme.font-size-label;
            wrap: word-wrap;
        }
        }
    }
}
