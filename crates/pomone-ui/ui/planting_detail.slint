// Pomone — read-only Planting detail screen.
//
// Header carries the variety label and a Back button; below it, two cards:
// a "schedule" card built from a list of label/value lines (the Rust side
// chooses which lines to emit based on Cycle vs Perennial), and a "summary"
// card with location, area, plants count, optional name and notes.

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader, ThemedLineEdit, ThemedComboBox } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct DetailLine {
    label: string,
    value: string,
}

export struct YearlyHarvestRow {
    year: int,
    expected-label: string,
    actual-label: string,
    variance-label: string,
    notes: string,
}

export struct TreatmentRow {
    treatment-id: string,
    applied-on: string,
    active-substance: string,
    product-name: string,
    dose-label: string,
    notes: string,
}

export struct PlantingTaskRow {
    task-id: string,
    planned-on: string,
    type-name: string,
    color: color,
    completed: bool,
    // `true` when the task was skipped — row greyed + struck + reason badge
    // (story 1.6). Mutually exclusive with `completed`.
    skipped: bool,
    // Localized skip-reason label; empty unless `skipped`.
    skip-reason: string,
    overdue: bool,
    notes: string,
}

export component PlantingDetailPage inherits Rectangle {
    background: Palette.background;

    in property <string> title-text;
    in property <string> back-button-text;
    in property <string> variety-label;
    in property <string> location-label;
    in property <string> strata-label;
    in property <string> area-label;
    in property <int> plants-count;

    in property <string> name-label;          // localized "Name"
    in property <string> name-value;          // empty if not set
    in property <string> notes-label;         // localized "Notes"
    in property <string> notes-value;         // empty if not set

    in property <string> section-schedule-text;
    in property <string> section-summary-text;
    in property <string> label-location;
    in property <string> label-strata;
    in property <string> label-area;
    in property <string> label-plants-count;

    in property <[DetailLine]> schedule-lines;

    in property <string> empty-state-text;    // shown when no detail loaded
    in property <bool> has-detail;

    // ---------- Life-cycle status & delete (issue #63) ----------
    in property <string> status-label;            // current status, localized (badge)
    in property <string> status-section-text;     // card title ("Life cycle")
    in property <string> status-field-label;      // "Status"
    in property <[string]> status-options;        // 4 localized status labels
    in-out property <int> status-index;           // selected status in the combo
    in property <string> change-status-text;      // "Change status" button
    in property <string> delete-button-text;      // "Delete planting" button
    in property <string> lifecycle-status-text;   // action result message
    in property <bool> lifecycle-status-is-error: false;
    callback change-status();
    callback delete-planting();

    // ---------- Tasks section ----------
    in property <string> tasks-section-text;
    in property <string> tasks-empty-text;
    in property <string> tasks-overdue-badge;   // localized "overdue"
    in property <string> tasks-done-badge;      // localized "done"
    in property <string> tasks-skipped-badge;   // localized "skipped"
    in property <[PlantingTaskRow]> task-rows;
    callback task-clicked(string);              // task-id

    // ---------- Yearly harvest section (perennials only) ----------
    in property <bool> is-perennial;
    in property <string> harvest-section-title;
    in property <string> harvest-empty-text;
    in property <string> harvest-header-year;
    in property <string> harvest-header-expected;
    in property <string> harvest-header-actual;
    in property <string> harvest-header-variance;
    in property <string> harvest-header-notes;
    in property <[YearlyHarvestRow]> harvest-rows;
    in property <string> harvest-form-section;
    in property <string> harvest-label-year;
    in property <string> harvest-label-expected;
    in property <string> harvest-label-actual;
    in property <string> harvest-label-notes;
    in property <string> harvest-placeholder-year;
    in property <string> harvest-placeholder-kg;
    in property <string> harvest-placeholder-notes;
    in property <string> harvest-record-button;
    in property <string> harvest-status-text;
    in property <bool> harvest-status-is-error: false;
    in-out property <string> new-harvest-year;
    in-out property <string> new-harvest-expected;
    in-out property <string> new-harvest-actual;
    in-out property <string> new-harvest-notes;

    // ---------- Treatments section (phytosanitary traceability, issue #82) ----------
    in property <string> treatments-section-title;
    in property <string> treatments-empty-text;
    in property <string> treatment-header-date;
    in property <string> treatment-header-substance;
    in property <string> treatment-header-product;
    in property <string> treatment-header-dose;
    in property <string> treatment-header-notes;
    in property <[TreatmentRow]> treatment-rows;
    in property <string> treatment-form-section;
    in property <string> treatment-label-date;
    in property <string> treatment-label-substance;
    in property <string> treatment-label-product;
    in property <string> treatment-label-dose;
    in property <string> treatment-label-unit;
    in property <string> treatment-label-notes;
    in property <string> treatment-placeholder-substance;
    in property <string> treatment-placeholder-product;
    in property <string> treatment-placeholder-dose;
    in property <string> treatment-placeholder-unit;
    in property <string> treatment-placeholder-notes;
    in property <string> treatment-record-button;
    in property <string> treatment-delete-button;
    in property <string> treatment-status-text;
    in property <bool> treatment-status-is-error: false;
    in-out property <string> new-treatment-date;
    in-out property <string> new-treatment-substance;
    in-out property <string> new-treatment-product;
    in-out property <string> new-treatment-dose;
    in-out property <string> new-treatment-unit;
    in-out property <string> new-treatment-notes;

    callback go-back();
    callback record-harvest();
    callback record-treatment();
    callback delete-treatment(string);   // treatment-id

    // The detail page has up to three stacked Cards (schedule, summary,
    // yearly-harvest) and can overflow on smaller windows — wrap the body
    // in a ScrollView so the content stays reachable.
    ScrollView {
        VerticalLayout {
        padding: Theme.space-2xl;
        spacing: Theme.space-xl;

        // ---------- Header ----------
        HorizontalLayout {
            spacing: Theme.space-md;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: title-text;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-label;
                    font-weight: Theme.font-weight-medium;
                }
                Text {
                    text: has-detail ? variety-label : "";
                    color: Palette.primary;
                    font-size: Theme.font-size-h1;
                    font-weight: Theme.font-weight-bold;
                }
            }
            // Current life-cycle status badge (issue #63).
            if has-detail && status-label != "": Rectangle {
                background: Palette.surface-alt;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Palette.border;
                horizontal-stretch: 0;
                HorizontalLayout {
                    padding-left: Theme.space-sm;
                    padding-right: Theme.space-sm;
                    padding-top: Theme.space-xs;
                    padding-bottom: Theme.space-xs;
                    Text {
                        text: status-label;
                        color: Palette.text-secondary;
                        font-size: Theme.font-size-label;
                        font-weight: Theme.font-weight-semibold;
                        vertical-alignment: center;
                    }
                }
            }
            SecondaryButton {
                text: back-button-text;
                clicked => { go-back(); }
            }
        }

        if !has-detail: Card {
            VerticalLayout {
                padding: Theme.space-xl;
                Text {
                    text: empty-state-text;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if has-detail: HorizontalLayout {
            spacing: Theme.space-xl;
            vertical-stretch: 1;

            // -------- Schedule card --------
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-md;

                    SectionHeader { text: section-schedule-text; }

                    for line in schedule-lines: HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: line.label;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: line.value;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                        }
                    }
                }
            }

            // -------- Summary card --------
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Theme.space-xl;
                    spacing: Theme.space-md;

                    SectionHeader { text: section-summary-text; }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: label-location;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: location-label;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: label-strata;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: strata-label;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: label-area;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: area-label;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: label-plants-count;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: plants-count;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                        }
                    }

                    // Optional name + notes appear only when set on the planting.
                    if name-value != "": HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: name-label;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: name-value;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                        }
                    }
                    if notes-value != "": VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: notes-label;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        Text {
                            text: notes-value;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ---------- Life-cycle status & delete (issue #63) ----------
        if has-detail: Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-md;

                SectionHeader { text: status-section-text; }

                HorizontalLayout {
                    spacing: Theme.space-md;
                    alignment: start;
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: status-field-label;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedComboBox {
                            model: status-options;
                            current-index <=> status-index;
                            min-width: 200px;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: " ";
                            font-size: Theme.font-size-label;
                        }
                        PrimaryButton {
                            text: change-status-text;
                            clicked => { change-status(); }
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: " ";
                            font-size: Theme.font-size-label;
                        }
                        SecondaryButton {
                            text: delete-button-text;
                            clicked => { delete-planting(); }
                        }
                    }
                }

                if lifecycle-status-text != "": Text {
                    text: lifecycle-status-text;
                    color: lifecycle-status-is-error ? Palette.danger : Palette.success;
                    font-size: Theme.font-size-label;
                    wrap: word-wrap;
                }
            }
        }

        // ---------- Tasks attached to this planting ----------
        if has-detail: Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-md;

                SectionHeader { text: tasks-section-text; }

                if task-rows.length == 0: Text {
                    text: tasks-empty-text;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-body;
                    horizontal-alignment: center;
                }

                for task in task-rows: Rectangle {
                    border-radius: Theme.radius-sm;
                    background: row-touch.has-hover ? Palette.surface-alt : transparent;

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.task-clicked(task.task-id); }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        padding-top: Theme.space-xs;
                        padding-bottom: Theme.space-xs;
                        spacing: Theme.space-md;

                        // Colored dot for the task type.
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: task.color;
                            y: (parent.height - self.height) / 2;
                        }

                        // Label, struck through when skipped (Slint has no
                        // strikethrough attribute — overlay a thin line).
                        Rectangle {
                            horizontal-stretch: 1;
                            name := Text {
                                text: task.type-name;
                                color: (task.completed || task.skipped) ? Palette.text-muted : Palette.text-primary;
                                font-size: Theme.font-size-body;
                                font-weight: Theme.font-weight-semibold;
                                vertical-alignment: center;
                                overflow: elide;
                                width: 100%;
                                // Fill the wrapper so vertical-alignment centers
                                // the text (and the strike overlay) in the row.
                                height: 100%;
                            }
                            if task.skipped: Rectangle {
                                height: 1px;
                                width: min(name.preferred-width, parent.width);
                                x: 0;
                                y: parent.height / 2;
                                background: Palette.text-muted;
                            }
                        }

                        // Status badge: done > skipped > overdue (mutually
                        // exclusive; skipped carries its reason).
                        if task.completed: Text {
                            text: tasks-done-badge;
                            color: Palette.success;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            vertical-alignment: center;
                        }
                        if task.skipped: Text {
                            text: task.skip-reason == "" ? tasks-skipped-badge
                                : tasks-skipped-badge + " · " + task.skip-reason;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            vertical-alignment: center;
                        }
                        if !task.completed && !task.skipped && task.overdue: Text {
                            text: tasks-overdue-badge;
                            color: Palette.danger;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            vertical-alignment: center;
                        }

                        Text {
                            text: task.planned-on;
                            color: task.overdue && !task.completed && !task.skipped ? Palette.danger : Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---------- Yearly harvest (perennials only) ----------
        if has-detail && is-perennial: Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-md;

                SectionHeader { text: harvest-section-title; }

                // Header row + body rows, side-by-side via plain
                // HorizontalLayout (so column widths follow content).
                VerticalLayout {
                    spacing: Theme.space-xs;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: harvest-header-year;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 80px;
                        }
                        Text {
                            text: harvest-header-expected;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 120px;
                        }
                        Text {
                            text: harvest-header-actual;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 120px;
                        }
                        Text {
                            text: harvest-header-variance;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 120px;
                        }
                        Text {
                            text: harvest-header-notes;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            horizontal-stretch: 1;
                        }
                    }

                    if harvest-rows.length == 0: Text {
                        text: harvest-empty-text;
                        color: Palette.text-muted;
                        font-size: Theme.font-size-body;
                        horizontal-alignment: center;
                    }

                    for row in harvest-rows: HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: row.year;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                            width: 80px;
                        }
                        Text {
                            text: row.expected-label;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            width: 120px;
                        }
                        Text {
                            text: row.actual-label;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            width: 120px;
                        }
                        Text {
                            text: row.variance-label;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-body;
                            width: 120px;
                        }
                        Text {
                            text: row.notes;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-body;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.border; }

                // Add / update form
                SectionHeader { text: harvest-form-section; }

                HorizontalLayout {
                    spacing: Theme.space-md;
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: harvest-label-year;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-harvest-year;
                            placeholder-text: harvest-placeholder-year;
                            input-type: number;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: harvest-label-expected;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-harvest-expected;
                            placeholder-text: harvest-placeholder-kg;
                            input-type: decimal;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: harvest-label-actual;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-harvest-actual;
                            placeholder-text: harvest-placeholder-kg;
                            input-type: decimal;
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-xs;
                    Text {
                        text: harvest-label-notes;
                        color: Palette.text-secondary;
                        font-size: Theme.font-size-label;
                    }
                    ThemedLineEdit {
                        text <=> new-harvest-notes;
                        placeholder-text: harvest-placeholder-notes;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-md;
                    PrimaryButton {
                        text: harvest-record-button;
                        clicked => { record-harvest(); }
                    }
                    Text {
                        text: harvest-status-text;
                        color: harvest-status-is-error ? Palette.danger : Palette.success;
                        font-size: Theme.font-size-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ---------- Treatments (phytosanitary traceability, issue #82) ----------
        if has-detail: Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-md;

                SectionHeader { text: treatments-section-title; }

                VerticalLayout {
                    spacing: Theme.space-xs;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: treatment-header-date;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 100px;
                        }
                        Text {
                            text: treatment-header-substance;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 140px;
                        }
                        Text {
                            text: treatment-header-product;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 160px;
                        }
                        Text {
                            text: treatment-header-dose;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            width: 110px;
                        }
                        Text {
                            text: treatment-header-notes;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-label;
                            font-weight: Theme.font-weight-semibold;
                            horizontal-stretch: 1;
                        }
                        // Spacer over the per-row delete button column.
                        Rectangle { width: 80px; }
                    }

                    if treatment-rows.length == 0: Text {
                        text: treatments-empty-text;
                        color: Palette.text-muted;
                        font-size: Theme.font-size-body;
                        horizontal-alignment: center;
                    }

                    for row in treatment-rows: HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: row.applied-on;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: Theme.font-weight-semibold;
                            vertical-alignment: center;
                            width: 100px;
                        }
                        Text {
                            text: row.active-substance;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            vertical-alignment: center;
                            width: 140px;
                            overflow: elide;
                        }
                        Text {
                            text: row.product-name;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            vertical-alignment: center;
                            width: 160px;
                            overflow: elide;
                        }
                        Text {
                            text: row.dose-label;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-body;
                            vertical-alignment: center;
                            width: 110px;
                        }
                        Text {
                            text: row.notes;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-body;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        SecondaryButton {
                            text: treatment-delete-button;
                            compact: true;
                            danger: true;
                            clicked => { root.delete-treatment(row.treatment-id); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.border; }

                // Record form
                SectionHeader { text: treatment-form-section; }

                HorizontalLayout {
                    spacing: Theme.space-md;
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: treatment-label-date;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-treatment-date;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: treatment-label-substance;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-treatment-substance;
                            placeholder-text: treatment-placeholder-substance;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: treatment-label-product;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-treatment-product;
                            placeholder-text: treatment-placeholder-product;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: treatment-label-dose;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-treatment-dose;
                            placeholder-text: treatment-placeholder-dose;
                            input-type: decimal;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: treatment-label-unit;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> new-treatment-unit;
                            placeholder-text: treatment-placeholder-unit;
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-xs;
                    Text {
                        text: treatment-label-notes;
                        color: Palette.text-secondary;
                        font-size: Theme.font-size-label;
                    }
                    ThemedLineEdit {
                        text <=> new-treatment-notes;
                        placeholder-text: treatment-placeholder-notes;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-md;
                    PrimaryButton {
                        text: treatment-record-button;
                        clicked => { record-treatment(); }
                    }
                    Text {
                        text: treatment-status-text;
                        color: treatment-status-is-error ? Palette.danger : Palette.success;
                        font-size: Theme.font-size-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
            }
        }
        }
    }
}
