// Pomone — Families catalog screen.
//
// Manages the botanical families (Solanacées, Rosacées…) and, above all,
// their user-configurable colour, which tints plantings and the crop map by
// family (mirrors Qrop's `family.color`). Pre-seeded with 11 families the
// user can rename, recolour, or extend.
//
// Layout mirrors `task_types.slint`: list on the left (2/3), form on the
// right (1/3). The form doubles as create + edit; the host flips
// `is-edit-mode` on row-click and pre-fills the in-out properties.

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader, ThemedLineEdit, ColorPickerField, PaletteColor } from "theme.slint";
import { ScrollView, ListView } from "std-widgets.slint";

export struct FamilyAdminItem {
    id: string,
    name: string,
    latin-name: string,
    /// Resolved colour for the swatch. Parsed Rust-side from the hex string.
    color: color,
    /// Raw hex (e.g. "#B85C38") — surfaced so the row can pre-fill the form.
    color-hex: string,
    in-use: bool,
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch-color;
    width: 24px;
    height: 24px;
    border-radius: Theme.radius-sm;
    border-width: Theme.border-width;
    border-color: Palette.border-strong;
    background: swatch-color;
}

component FamilyRowView inherits Card {
    in property <FamilyAdminItem> entry;
    in property <string> edit-text;
    in property <string> delete-text;
    in property <string> in-use-text;
    callback edit(string);
    callback delete(string);
    height: 80px;

    HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-md;
        alignment: center;

        ColorSwatch { swatch-color: entry.color; }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: entry.name;
                color: Palette.text-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-semibold;
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                if entry.latin-name != "": Text {
                    text: entry.latin-name;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-label;
                    vertical-alignment: center;
                }
                if entry.in-use: Text {
                    text: in-use-text;
                    color: Palette.text-secondary;
                    font-size: Theme.font-size-label;
                    vertical-alignment: center;
                }
            }
        }

        SecondaryButton {
            text: edit-text;
            clicked => { edit(entry.id); }
        }
        SecondaryButton {
            text: delete-text;
            enabled: !entry.in-use;
            clicked => { delete(entry.id); }
        }
    }
}

export component FamiliesPage inherits Rectangle {
    background: Palette.background;

    // Chrome strings
    in property <string> title-text;
    in property <string> list-title;
    in property <string> empty-text;
    in property <string> form-section-create;
    in property <string> form-section-edit;
    in property <string> label-name;
    in property <string> placeholder-name;
    in property <string> label-latin;
    in property <string> placeholder-latin;
    in property <string> label-description;
    in property <string> placeholder-description;
    in property <string> label-color;
    in property <string> placeholder-color;
    in property <string> hint-color;
    // Preset palette for the swatch-grid chooser (built Rust-side).
    in property <[PaletteColor]> color-palette;
    in property <string> btn-save-text;
    in property <string> btn-cancel-text;
    in property <string> edit-text;
    in property <string> delete-text;
    in property <string> in-use-text;
    in property <string> status-text;
    in property <bool> status-is-error: false;

    // Data
    in property <[FamilyAdminItem]> families;

    // Form state
    in property <bool> is-edit-mode: false;
    in-out property <string> form-name;
    in-out property <string> form-latin;
    in-out property <string> form-description;
    in-out property <string> form-color: "#6B5D4D";
    /// Preview colour of the swatch. The host sets it on load/reset; picking a
    /// palette swatch updates it live (in-out so the picker can write it).
    in-out property <color> form-color-preview;

    callback save();
    callback cancel();
    callback edit-row(string);
    callback delete-row(string);

    ScrollView {
        VerticalLayout {
            padding: Theme.space-2xl;
            spacing: Theme.space-xl;

            Text {
                text: title-text;
                color: Palette.primary;
                font-size: Theme.font-size-h1;
                font-weight: Theme.font-weight-bold;
            }

            HorizontalLayout {
                spacing: Theme.space-xl;

                // -------- List --------
                Card {
                    horizontal-stretch: 2;
                    VerticalLayout {
                        padding: Theme.space-xl;
                        spacing: Theme.space-md;

                        SectionHeader { text: list-title; }

                        if families.length == 0: Text {
                            text: empty-text;
                            color: Palette.text-muted;
                            font-size: Theme.font-size-body;
                            horizontal-alignment: center;
                        }
                        if families.length > 0: list-area := Rectangle {
                            min-height: 320px;
                            preferred-height: 480px;
                            vertical-stretch: 1;
                            ListView {
                                for item in families: FamilyRowView {
                                    entry: item;
                                    edit-text: edit-text;
                                    delete-text: delete-text;
                                    in-use-text: in-use-text;
                                    width: list-area.width;
                                    edit(id) => { edit-row(id); }
                                    delete(id) => { delete-row(id); }
                                }
                            }
                        }
                    }
                }

                // -------- Form --------
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Theme.space-xl;
                        spacing: Theme.space-md;

                        SectionHeader {
                            text: is-edit-mode ? form-section-edit : form-section-create;
                        }

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: label-name;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> form-name;
                                placeholder-text: placeholder-name;
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: label-latin;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> form-latin;
                                placeholder-text: placeholder-latin;
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: label-description;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            ThemedLineEdit {
                                text <=> form-description;
                                placeholder-text: placeholder-description;
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: label-color;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label;
                            }
                            // Compact colour field — opens the swatch grid in a
                            // popup so the form stays short.
                            ColorPickerField {
                                palette: color-palette;
                                hex <=> form-color;
                                preview <=> form-color-preview;
                                custom-placeholder: placeholder-color;
                            }
                            Text {
                                text: hint-color;
                                color: Palette.text-muted;
                                font-size: Theme.font-size-label;
                            }
                        }

                        if status-text != "": Text {
                            text: status-text;
                            color: status-is-error ? Palette.danger : Palette.text-secondary;
                            font-size: Theme.font-size-label;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-md;
                            alignment: end;
                            if is-edit-mode: SecondaryButton {
                                text: btn-cancel-text;
                                clicked => { cancel(); }
                            }
                            PrimaryButton {
                                text: btn-save-text;
                                clicked => { save(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
