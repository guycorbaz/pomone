import { LineEdit } from "std-widgets.slint";

// Material Icons — the same monochrome glyph font Qrop ships. Embedding it
// lets us tint icons with our palette (they inherit `color`) and keeps the
// look crisp under the software renderer. Apache-2.0 licensed.
import "../assets/fonts/MaterialIcons-Regular.ttf";

// Pomone design tokens.
//
// Two globals are exposed:
//   * `Palette` — semantic colours, derived from a single `dark` toggle.
//     Every screen reads colours from here so that flipping the toggle
//     switches the whole UI between light and dark themes.
//   * `Theme` — non-colour tokens: spacing scale, type scale, radii, weights.
//
// Visual direction: "orchard / garden" — leaf greens for primary actions,
// terracotta for accents, warm cream for the light surface, dark olive for
// the dark surface. WCAG AA contrast was checked for text on every surface.

export global Palette {
    // Flip this at runtime to switch the whole UI to dark mode.
    in-out property <bool> dark: false;

    // Backgrounds
    out property <brush> background: dark ? #1B2018 : #FBF7F0;
    out property <brush> surface: dark ? #242B23 : #FFFFFF;
    out property <brush> surface-alt: dark ? #2D352C : #F3EDE0;
    out property <brush> overlay: dark ? #00000080 : #00000026;

    // Text — tuned for a higher perceived contrast against both the cream
    // light background (#FBF7F0) and the dark olive background (#1B2018).
    out property <brush> text-primary: dark ? #F5F1E5 : #1F1810;
    out property <brush> text-secondary: dark ? #D1CAB3 : #3F3528;
    out property <brush> text-muted: dark ? #A09887 : #6B5D4D;
    out property <brush> text-on-primary: #FFFFFF;
    out property <brush> text-on-accent: #FFFFFF;

    // Borders / dividers
    out property <brush> border: dark ? #3B4439 : #E2D7C2;
    out property <brush> border-strong: dark ? #55604F : #C8B89A;

    // Primary action — leaf green
    out property <brush> primary: dark ? #6FAF7A : #3C6E47;
    out property <brush> primary-hover: dark ? #7FBF8A : #2F5938;
    out property <brush> primary-pressed: dark ? #5F9F6A : #244529;

    // Accent — terracotta
    out property <brush> accent: dark ? #D87858 : #B85C38;
    out property <brush> accent-hover: dark ? #E88868 : #9A4A2C;
    out property <brush> accent-pressed: dark ? #C86848 : #7E3A22;

    // Focus ring — light leaf green, visible on both themes
    out property <brush> focus-ring: dark ? #9FD0A8 : #6A9F77;

    // Status colours (kept gentle so they don't shout in a data-heavy UI)
    out property <brush> success: dark ? #6FAF7A : #3C6E47;
    out property <brush> warning: dark ? #E3B567 : #B07C25;
    out property <brush> danger: dark ? #D88078 : #A64238;
}

export global Theme {
    // Spacing scale (multiples of 4px).
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 20px;
    out property <length> space-2xl: 24px;
    out property <length> space-3xl: 40px;

    // Type scale. Nudged down from the original (body 18) towards Qrop's denser
    // feel, but kept comfortably readable on HiDPI desktop displays — a middle
    // ground, not Qrop's full 14px spreadsheet density.
    out property <length> font-size-h1: 36px;
    out property <length> font-size-h2: 27px;
    out property <length> font-size-h3: 22px;
    out property <length> font-size-body: 18px;
    out property <length> font-size-label: 17px;
    out property <length> font-size-numeric: 31px;

    out property <int> font-weight-regular: 400;
    out property <int> font-weight-medium: 500;
    out property <int> font-weight-semibold: 600;
    out property <int> font-weight-bold: 700;

    // Icon font family (embedded at the top of this file).
    out property <string> icon-font: "Material Icons";
    out property <length> icon-size: 21px;

    // Control heights — a dense scale echoing Qrop's Material "Dense" variant
    // (Qrop: table rows 42, fields 32, buttons 36, toolbar 48). Screens should
    // read these instead of hard-coding pixel heights so density stays uniform.
    out property <length> control-height: 42px;
    out property <length> control-height-compact: 36px;
    out property <length> row-height: 46px;
    out property <length> field-height: 42px;

    // Radii.
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-pill: 999px;

    // Borders.
    out property <length> border-width: 1px;
    out property <length> focus-ring-width: 2px;

    // Animation timing — kept short so the UI feels snappy on slower hardware.
    out property <duration> transition-fast: 120ms;
    out property <duration> transition-medium: 200ms;
}

// Named Material Icons glyphs. Screens reference `Icons.home` rather than raw
// code points, so the icon vocabulary is discoverable in one place and easy to
// re-map. Render these in a `Text` with `font-family: Theme.icon-font`.
export global Icons {
    out property <string> home: "\u{e88a}";
    out property <string> plantings: "\u{e25c}";   // local_florist
    out property <string> tasks: "\u{e85d}";        // assignment
    out property <string> agenda: "\u{e878}";       // event
    out property <string> cultures: "\u{e63f}";     // eco (leaf)
    out property <string> families: "\u{e87b}";     // spa (flower)
    out property <string> locations: "\u{e55f}";    // place
    out property <string> strata: "\u{e53b}";       // layers
    out property <string> crop-map: "\u{e55b}";     // map
    out property <string> settings: "\u{e8b8}";     // settings
    out property <string> help: "\u{e8fd}";         // help_outline
}

// Contextual-help tooltip state (#39). One bubble per window: interactive
// components report hover enter/leave here, and `TooltipLayer` (drawn last
// by MainWindow, see components/tooltip.slint) renders the single active
// bubble above every page — no per-page plumbing, no z-order fights.
export global TooltipState {
    in-out property <bool> active: false;
    in-out property <string> text: "";
    // Top-left corner + height of the hovered element, in window coordinates
    // (`absolute-position`). The layer anchors the bubble below the element.
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-height;

    public function show(tip: string, x: length, y: length, h: length) {
        if (tip == "") {
            return;
        }
        self.text = tip;
        self.anchor-x = x;
        self.anchor-y = y;
        self.anchor-height = h;
        self.active = true;
    }
    // Guarded by `tip` so a stale leave (fired after the pointer already
    // entered another tooltip'd element) doesn't kill the new bubble.
    public function hide(tip: string) {
        if (self.text == tip) {
            self.active = false;
        }
    }
}

// One entry of a `ColorPicker` palette: the display colour plus the raw hex
// string the form stores. Rust builds the palette (parsing hex → colour once)
// and the picker emits the hex back on selection.
export struct PaletteColor {
    hex: string,
    color: color,
}

// A swatch-grid colour chooser — a software-renderer-friendly alternative to a
// native colour dialog. Click a swatch to pick; the current selection gets a
// ring. `picked` carries both the hex (for the form field) and the resolved
// colour (so the caller can update a live preview without re-parsing).
export component ColorPicker inherits Rectangle {
    in property <[PaletteColor]> palette;
    // Hex of the currently-selected colour; the matching swatch is ringed.
    in property <string> selected-hex;
    callback picked(string, color);

    property <int> columns: 6;
    property <length> cell: 28px;
    property <length> gap: 8px;
    property <int> row-count: Math.ceil(palette.length / columns);

    horizontal-stretch: 0;
    // Hug the grid: `columns` swatches across, `row-count` down.
    min-width: columns * cell + (columns - 1) * gap;
    height: row-count * cell + max(0, row-count - 1) * gap;

    for item[idx] in palette: Rectangle {
        x: mod(idx, root.columns) * (root.cell + root.gap);
        y: floor(idx / root.columns) * (root.cell + root.gap);
        width: root.cell;
        height: root.cell;
        border-radius: Theme.radius-sm;
        background: item.color;
        // Selected swatch: a light ring drawn as an inset border.
        border-width: item.hex == root.selected-hex ? Theme.focus-ring-width : Theme.border-width;
        border-color: item.hex == root.selected-hex ? Palette.focus-ring : Palette.border-strong;

        swatch-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(item.hex, item.color); }
        }

        // Checkmark on the selected swatch for a clear, colour-blind-safe cue.
        if item.hex == root.selected-hex: Text {
            text: "✓";
            color: Palette.text-on-primary;
            font-size: Theme.font-size-label;
            font-weight: Theme.font-weight-bold;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
}

// Compact colour field that opens the swatch grid in a popup — saves vertical
// space in a form versus an always-visible grid. Shows the current colour +
// hex + a caret; click to open. Picking a swatch (or typing a custom hex in the
// popup) updates `hex`/`preview` in place, so a host just two-way binds both.
export component ColorPickerField inherits Rectangle {
    in property <[PaletteColor]> palette;
    in-out property <string> hex;
    in-out property <color> preview;
    in property <bool> enabled: true;
    in property <string> custom-placeholder;

    height: Theme.field-height;
    min-width: 160px;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    border-color: enabled ? Palette.border-strong : Palette.border;
    background: enabled ? Palette.surface : Palette.surface-alt;

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                popup.show();
            }
        }

        HorizontalLayout {
            padding-left: Theme.space-sm;
            padding-right: Theme.space-sm;
            spacing: Theme.space-sm;

            // Current-colour swatch.
            Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                border-width: Theme.border-width;
                border-color: Palette.border-strong;
                background: root.preview;
            }
            Text {
                text: root.hex;
                color: Palette.text-primary;
                font-size: Theme.font-size-body;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: "▾";
                color: Palette.text-muted;
                font-size: Theme.font-size-label;
                vertical-alignment: center;
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;

        Rectangle {
            background: Palette.surface;
            border-width: Theme.border-width;
            border-color: Palette.border-strong;
            border-radius: Theme.radius-md;

            VerticalLayout {
                padding: Theme.space-md;
                spacing: Theme.space-md;

                ColorPicker {
                    palette: root.palette;
                    selected-hex: root.hex;
                    picked(picked-hex, picked-color) => {
                        root.hex = picked-hex;
                        root.preview = picked-color;
                        popup.close();
                    }
                }

                // Free hex entry for a fully custom colour. Uses the base
                // LineEdit (defined-later `ThemedLineEdit` isn't in scope here)
                // with our body font size.
                LineEdit {
                    font-size: Theme.font-size-body;
                    text <=> root.hex;
                    placeholder-text: root.custom-placeholder;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Reusable components built on top of the tokens above. Screens compose these
// rather than restyling primitives every time.
// ---------------------------------------------------------------------------

// A surface that hosts content groups (cards, panels, list rows).
export component Card inherits Rectangle {
    background: Palette.surface;
    border-color: Palette.border;
    border-width: Theme.border-width;
    border-radius: Theme.radius-md;
}

// Primary action button. The TouchArea wraps the visual content so its hit-
// box always matches the painted button — that's the idiomatic Slint pattern.
// FocusScope sits as a sibling beneath the TouchArea (in z-order) so the
// TouchArea still wins for mouse events but the FocusScope catches Tab/Space
// /Enter. The focus ring is drawn *inside* the button bounds (inset) so it
// never overlaps the next widget in the layout.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // Optional hover-help text; empty = no tooltip (see TooltipState).
    in property <string> tip;
    callback clicked();

    height: Theme.control-height;
    // Hug content + comfortable padding so long labels don't get elided
    // ("Tester la connexion" was being cut to "Tester la c" before).
    min-width: max(120px, button-text.preferred-width + 2 * Theme.space-xl);
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: !enabled ? Palette.border
                : touch.pressed ? Palette.primary-pressed
                : touch.has-hover ? Palette.primary-hover
                : Palette.primary;

    animate background { duration: Theme.transition-fast; }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if ((event.text == " " || event.text == "\n") && root.enabled) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                TooltipState.hide(root.tip);
            }
        }
        clicked => {
            if (root.enabled) {
                TooltipState.active = false;
                focus-scope.focus();
                root.clicked();
            }
        }

        button-text := Text {
            text: root.text;
            color: Palette.text-on-primary;
            font-size: Theme.font-size-body;
            font-weight: Theme.font-weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
            x: Theme.space-lg;
            y: 0;
            width: parent.width - 2 * Theme.space-lg;
            height: parent.height;
        }
    }

    // Inset focus ring — sits on top, transparent background so it doesn't
    // intercept clicks; the inset keeps it inside the button bounds.
    if focus-scope.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-color: Palette.focus-ring;
        border-width: Theme.focus-ring-width;
        border-radius: Theme.radius-md - 2px;
        background: transparent;
    }
}

// Secondary / ghost button — outlined, transparent background, primary text.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // `compact` shrinks the button for dense list-row actions; `danger` tints
    // it red (used for destructive actions like Delete).
    in property <bool> compact: false;
    in property <bool> danger: false;
    // Optional hover-help text; empty = no tooltip (see TooltipState).
    in property <string> tip;
    callback clicked();

    property <length> pad: compact ? Theme.space-md : Theme.space-xl;
    property <brush> edge: danger ? Palette.danger : Palette.border-strong;

    height: compact ? Theme.control-height-compact : Theme.control-height;
    // Hug content + comfortable padding (see PrimaryButton's note).
    min-width: max(compact ? 72px : 120px, secondary-text.preferred-width + 2 * root.pad);
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    border-color: enabled ? root.edge : Palette.border;
    background: !enabled ? transparent
                : touch.pressed ? Palette.surface-alt
                : touch.has-hover ? Palette.surface-alt
                : transparent;

    animate background { duration: Theme.transition-fast; }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if ((event.text == " " || event.text == "\n") && root.enabled) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                TooltipState.hide(root.tip);
            }
        }
        clicked => {
            if (root.enabled) {
                TooltipState.active = false;
                focus-scope.focus();
                root.clicked();
            }
        }

        secondary-text := Text {
            text: root.text;
            color: !root.enabled ? Palette.text-muted
                   : root.danger ? Palette.danger
                   : Palette.text-primary;
            font-size: root.compact ? Theme.font-size-label : Theme.font-size-body;
            font-weight: Theme.font-weight-medium;
            horizontal-alignment: center;
            vertical-alignment: center;
            x: root.pad;
            y: 0;
            width: parent.width - 2 * root.pad;
            height: parent.height;
        }
    }

    if focus-scope.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-color: Palette.focus-ring;
        border-width: Theme.focus-ring-width;
        border-radius: Theme.radius-md - 2px;
        background: transparent;
    }
}

// Section header for grouping content inside cards or panels.
export component SectionHeader inherits Text {
    color: Palette.text-secondary;
    font-size: Theme.font-size-label;
    font-weight: Theme.font-weight-semibold;
    // Letter-spacing isn't directly settable in Slint; we approximate the
    // "uppercase eyebrow" feel through weight + colour alone.
}

// LineEdit wrapper that forces our body font size — `std-widgets` defaults
// to the platform-native font scale, which renders noticeably smaller than
// our typography token.
export component ThemedLineEdit inherits LineEdit {
    font-size: Theme.font-size-body;
}

// Custom dropdown that matches `ThemedLineEdit`'s visual weight.
// `std-widgets::ComboBox` doesn't expose `font-size`, so we build a small
// popup-based replacement: a clickable "field" that displays the current
// label and opens a list below it on click. Keyboard nav: Up/Down change
// the selection in place; Enter / Space open the popup; Escape closes it.
export component ThemedComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    // Optional hover-help text; empty = no tooltip (see TooltipState).
    in property <string> tip;

    height: Theme.field-height;
    min-width: 120px;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    border-color: enabled ? Palette.border-strong : Palette.border;
    background: enabled ? Palette.surface : Palette.surface-alt;
    animate background, border-color { duration: Theme.transition-fast; }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled || root.model.length == 0) {
                return reject;
            }
            if (event.text == Key.DownArrow) {
                if (root.current-index < root.model.length - 1) {
                    root.current-index += 1;
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.current-index > 0) {
                    root.current-index -= 1;
                }
                return accept;
            }
            if (event.text == " " || event.text == "\n") {
                popup.show();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                TooltipState.hide(root.tip);
            }
        }
        clicked => {
            if (root.enabled && root.model.length > 0) {
                TooltipState.active = false;
                focus-scope.focus();
                popup.show();
            }
        }

        // Current value
        Text {
            text: root.model.length > root.current-index
                  && root.current-index >= 0
                  ? root.model[root.current-index]
                  : "";
            color: Palette.text-primary;
            font-size: Theme.font-size-body;
            x: Theme.space-md;
            y: 0;
            width: parent.width - 2 * Theme.space-md - 16px;
            height: parent.height;
            vertical-alignment: center;
            overflow: elide;
        }
        // Caret
        Text {
            text: "▾";
            color: Palette.text-muted;
            font-size: Theme.font-size-label;
            x: parent.width - Theme.space-md - 12px;
            width: 12px;
            height: parent.height;
            vertical-alignment: center;
        }
    }

    // Inset focus ring identical to the buttons.
    if focus-scope.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-color: Palette.focus-ring;
        border-width: Theme.focus-ring-width;
        border-radius: Theme.radius-md - 2px;
        background: transparent;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;

        Rectangle {
            background: Palette.surface;
            border-width: Theme.border-width;
            border-color: Palette.border-strong;
            border-radius: Theme.radius-md;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                for item[idx] in root.model: option := Rectangle {
                    height: Theme.control-height-compact;
                    border-radius: Theme.radius-sm;
                    background: idx == root.current-index ? Palette.surface-alt
                                : option-touch.has-hover ? Palette.surface-alt
                                : transparent;

                    option-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = idx;
                            popup.close();
                        }
                        Text {
                            text: item;
                            color: Palette.text-primary;
                            font-size: Theme.font-size-body;
                            font-weight: idx == root.current-index
                                         ? Theme.font-weight-semibold
                                         : Theme.font-weight-regular;
                            x: Theme.space-md;
                            y: 0;
                            width: parent.width - 2 * Theme.space-md;
                            height: parent.height;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Group heading inside the sidebar — a quiet "eyebrow" that separates the
// navigation into sections so a long flat list doesn't overwhelm.
export component NavSectionHeader inherits Text {
    color: Palette.text-muted;
    font-size: Theme.font-size-label - 2px;
    font-weight: Theme.font-weight-semibold;
}

// Sidebar navigation button. Filled in primary green when `selected`, ghost
// otherwise (hover state lifts the background slightly). Text is aligned to
// the left like every desktop sidebar.
export component NavButton inherits Rectangle {
    in property <string> text;
    // Material Icons glyph (e.g. `Icons.home`). Empty string = no icon.
    in property <string> icon;
    in property <bool> selected: false;
    // Optional hover-help text; empty = no tooltip (see TooltipState).
    in property <string> tip;
    callback clicked();

    property <brush> fg: selected ? Palette.text-on-primary : Palette.text-primary;

    height: Theme.control-height-compact;
    border-radius: Theme.radius-md;
    background: selected ? Palette.primary
                : touch.pressed ? Palette.surface-alt
                : touch.has-hover ? Palette.surface-alt
                : transparent;

    animate background { duration: Theme.transition-fast; }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.show(root.tip, root.absolute-position.x, root.absolute-position.y, root.height);
            } else {
                TooltipState.hide(root.tip);
            }
        }
        clicked => {
            TooltipState.active = false;
            focus-scope.focus();
            root.clicked();
        }

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            spacing: Theme.space-md;

            if root.icon != "": Text {
                text: root.icon;
                font-family: Theme.icon-font;
                font-size: Theme.icon-size;
                color: root.fg;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: Theme.icon-size + 2px;
            }

            Text {
                text: root.text;
                color: root.fg;
                font-size: Theme.font-size-body;
                font-weight: root.selected ? Theme.font-weight-semibold : Theme.font-weight-medium;
                horizontal-alignment: left;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }

    if focus-scope.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-color: Palette.focus-ring;
        border-width: Theme.focus-ring-width;
        border-radius: Theme.radius-md - 2px;
        background: transparent;
    }
}
