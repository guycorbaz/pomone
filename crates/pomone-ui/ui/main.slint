// Pomone — root Slint window.
//
// Layout is a persistent left sidebar (logo + navigation buttons + language
// switch in the footer) and a content area that swaps based on `current-page`.
// Every visible string and every list model is supplied by Rust through
// in-properties, keeping translations and data in a single Rust-side source
// of truth.

import { Palette, Theme, NavButton, SecondaryButton } from "theme.slint";
import { HomePage } from "home.slint";
import { Timeline, GanttBar } from "components/timeline.slint";
import { PlantingsPage, PlantingRow } from "plantings.slint";
import { CulturesPage, CropRow, VarietyRow } from "cultures.slint";
import { LocationsPage, LocationItem } from "locations.slint";
import { CalendarPage, CalendarDay, CalendarEvent } from "calendar.slint";
import { TaskCalendarPage, TaskCalendarDay, TaskRow } from "task_calendar.slint";
import { PlantingDetailPage, DetailLine, YearlyHarvestRow } from "planting_detail.slint";
import { StrataPage, StrataItem } from "strata.slint";
import { SettingsPage } from "settings.slint";

// Re-export so the generated Rust types are visible to `main.rs`.
export { PlantingRow, CropRow, VarietyRow, LocationItem, CalendarDay, CalendarEvent, TaskCalendarDay, TaskRow, DetailLine, YearlyHarvestRow, StrataItem, GanttBar }

export component MainWindow inherits Window {
    title: "Pomone";
    preferred-width: 1320px;
    preferred-height: 860px;
    min-width: 880px;
    min-height: 600px;
    background: Palette.background;

    // ------- Navigation -------
    in-out property <string> current-page: "home";

    // ------- Brand + home page strings -------
    in property <string> title-text;
    in property <string> welcome-text;
    in property <string> version-text;
    in property <string> section-overview-text;
    in property <string> label-strata;
    in property <string> label-families;
    in property <string> label-location-kinds;
    in property <int> count-strata;
    in property <int> count-families;
    in property <int> count-location-kinds;
    in property <string> language-button-text;
    in property <string> current-language-tag;

    // ------- Gantt timeline data (shared by Home and Plantings pages) -------
    // Rust pushes the planting → GanttBar conversion + locale-aware month
    // labels + today's day-of-year. Empty bars = empty grid (acceptable
    // placeholder).
    in property <[GanttBar]> gantt-bars;
    in property <[string]> gantt-month-labels;
    in property <int> gantt-today-day: -1;
    in property <string> section-season-text;       // Home Gantt card header
    in property <string> empty-season-text;          // Home Gantt empty state
    in property <string> section-gantt-text;        // Plantings Gantt card header

    // ------- Sidebar nav labels -------
    in property <string> nav-home-text;
    in property <string> nav-plantings-text;
    in property <string> nav-tasks-text;
    in property <string> nav-cultures-text;
    in property <string> nav-locations-text;
    in property <string> nav-calendar-text;
    in property <string> nav-strata-text;
    in property <string> nav-settings-text;
    in property <string> nav-help-text;

    callback toggle-language();
    callback navigate-home();
    callback navigate-plantings();
    callback navigate-tasks();
    callback navigate-cultures();
    callback navigate-locations();
    callback navigate-calendar();
    callback navigate-strata();
    callback navigate-settings();
    // Opens the bundled user manual PDF with the system default viewer.
    // Does not change `current-page`.
    callback open-manual();

    // ------- Plantings page state forwarded to PlantingsPage -------
    in property <string> plantings-title-text;
    in property <string> empty-state-text;
    in property <[PlantingRow]> plantings;
    in property <string> plants-suffix;
    in property <string> section-new-text;
    in property <string> label-variety;
    in property <string> label-location;
    in property <string> label-sown-on;
    in property <string> label-established-on;
    in property <string> label-removal-on;
    in property <string> label-area;
    in property <string> label-count;
    in property <string> placeholder-date;
    in property <string> placeholder-removal-date;
    in property <string> placeholder-area;
    in property <string> placeholder-count;
    in property <string> create-button-text;
    in property <[string]> variety-labels;
    in property <[string]> location-labels;
    in property <[bool]> variety-is-annuals;
    in-out property <int> variety-index: 0;
    in-out property <int> location-index: 0;
    in-out property <string> sown-on-text;
    in-out property <string> established-on-text;
    in-out property <string> removal-on-text;
    in-out property <string> area-text: "20";
    in-out property <string> count-text: "20";
    // Status banners are `in-out` so the page-level auto-clear Timers can
    // wipe them after a few seconds. Rust pushes the message via the
    // generated setter; Slint's Timer flips the text back to "" later.
    in-out property <string> status-text;
    in property <bool> status-is-error: false;
    callback create-planting();

    // ------- Cultures page state forwarded to CulturesPage -------
    in property <string> cultures-title-text;
    in property <string> crops-title;
    in property <string> empty-crops-text;
    in property <[CropRow]> crops;
    in-out property <int> selected-crop-index: -1;

    in property <string> new-crop-section;
    in property <string> label-crop-name;
    in property <string> placeholder-crop-name;
    in property <string> label-crop-latin;
    in property <string> placeholder-crop-latin;
    in property <string> label-crop-family;
    in property <string> label-crop-strata;
    in property <[string]> family-labels;
    in property <[string]> strata-labels;
    in-out property <int> family-index: 0;
    in-out property <int> strata-index: 0;
    in-out property <string> new-crop-name;
    in-out property <string> new-crop-latin;
    in property <string> label-lifespan;
    in property <[string]> lifespan-labels;
    in-out property <int> new-crop-lifespan-index: 0;
    in property <string> label-lifespan-years;
    in property <string> placeholder-lifespan-years;
    in-out property <string> new-crop-lifespan-years: "30";
    in property <string> label-years-to-first-yield;
    in property <string> placeholder-years-to-first-yield;
    in-out property <string> new-crop-years-to-first-yield: "3";
    in property <string> label-pruning;
    in property <[string]> pruning-labels;
    in-out property <int> new-crop-pruning-index: 0;
    in property <string> create-crop-button-text;
    callback create-crop();
    callback select-crop(int);

    in property <string> varieties-title;
    in property <string> empty-varieties-text;
    in property <string> no-crop-selected-text;
    in property <[VarietyRow]> varieties;
    in-out property <bool> selected-crop-is-annual: true;

    in property <string> new-variety-section;
    in property <string> label-variety-name;
    in property <string> placeholder-variety-name;
    in property <string> label-variety-description;
    in property <string> placeholder-variety-description;
    in property <string> label-dtt;
    in property <string> label-dtm;
    in property <string> label-window;
    in property <string> placeholder-dtt;
    in property <string> placeholder-dtm;
    in property <string> placeholder-window;
    in-out property <string> new-variety-name;
    in-out property <string> new-variety-description;
    in-out property <string> new-variety-dtt: "35";
    in-out property <string> new-variety-dtm: "70";
    in-out property <string> new-variety-window: "60";
    in property <string> label-bud-break-doy;
    in property <string> label-flowering-doy;
    in property <string> label-harvest-start-doy;
    in property <string> label-harvest-end-doy;
    in property <string> label-yield-kg;
    in property <string> placeholder-bud-break-doy;
    in property <string> placeholder-flowering-doy;
    in property <string> placeholder-harvest-start-doy;
    in property <string> placeholder-harvest-end-doy;
    in property <string> placeholder-yield-kg;
    in-out property <string> new-variety-bud-break-doy;
    in-out property <string> new-variety-flowering-doy;
    in-out property <string> new-variety-harvest-start-doy: "220";
    in-out property <string> new-variety-harvest-end-doy: "280";
    in-out property <string> new-variety-yield-kg;
    in property <string> create-variety-button-text;
    callback create-variety();

    // ------- Locations page state forwarded to LocationsPage -------
    in property <string> locations-title-text;
    in property <string> locations-list-title;
    in property <string> empty-locations-text;
    in property <[LocationItem]> locations;
    in property <string> location-form-section;
    in property <string> label-loc-name;
    in property <string> placeholder-loc-name;
    in property <string> label-loc-kind;
    in property <string> label-loc-length;
    in property <string> placeholder-loc-length;
    in property <string> label-loc-width;
    in property <string> placeholder-loc-width;
    in property <string> label-loc-parent;
    in property <string> label-loc-notes;
    in property <string> placeholder-loc-notes;
    in property <[string]> loc-kind-labels;
    in property <[string]> loc-parent-labels;
    in-out property <int> loc-kind-index: 0;
    in-out property <int> loc-parent-index: 0;
    in-out property <string> new-loc-name;
    in-out property <string> new-loc-length: "5";
    in-out property <string> new-loc-width: "2";
    in-out property <string> new-loc-notes;
    in property <string> create-loc-button-text;
    callback create-location();

    // ------- Calendar page state forwarded to CalendarPage -------
    in property <string> calendar-title-text;
    in property <string> calendar-month-label;
    in property <string> calendar-prev-button-text;
    in property <string> calendar-next-button-text;
    in property <string> calendar-today-button-text;
    in property <string> calendar-empty-state-text;
    in property <[string]> calendar-weekday-labels;
    in property <[CalendarDay]> calendar-days;
    in property <[string]> calendar-kind-labels;
    in property <bool> calendar-any-events;
    callback prev-month();
    callback next-month();
    callback go-today();
    callback calendar-event-clicked(string);
    callback planting-row-clicked(string);

    // ------- Planting detail page state forwarded to PlantingDetailPage -------
    in property <string> detail-title-text;
    in property <string> detail-back-button-text;
    in property <string> detail-variety-label;
    in property <string> detail-location-label;
    in property <string> detail-area-label;
    in property <int> detail-plants-count;
    in property <string> detail-name-label;
    in property <string> detail-name-value;
    in property <string> detail-notes-label;
    in property <string> detail-notes-value;
    in property <string> detail-section-schedule-text;
    in property <string> detail-section-summary-text;
    in property <string> detail-empty-state-text;
    in property <bool> detail-has-detail;
    in property <[DetailLine]> detail-schedule-lines;
    callback detail-go-back();

    // ------- Yearly harvest section (perennials only) -------
    in property <bool> detail-is-perennial;
    in property <string> harvest-section-title;
    in property <string> harvest-empty-text;
    in property <string> harvest-header-year;
    in property <string> harvest-header-expected;
    in property <string> harvest-header-actual;
    in property <string> harvest-header-variance;
    in property <string> harvest-header-notes;
    in property <[YearlyHarvestRow]> harvest-rows;
    in property <string> harvest-form-section;
    in property <string> harvest-label-year;
    in property <string> harvest-label-expected;
    in property <string> harvest-label-actual;
    in property <string> harvest-label-notes;
    in property <string> harvest-placeholder-year;
    in property <string> harvest-placeholder-kg;
    in property <string> harvest-placeholder-notes;
    in property <string> harvest-record-button;
    in-out property <string> harvest-status-text;
    in property <bool> harvest-status-is-error: false;
    in-out property <string> new-harvest-year;
    in-out property <string> new-harvest-expected;
    in-out property <string> new-harvest-actual;
    in-out property <string> new-harvest-notes;
    callback record-harvest();

    // ------- Strata page state forwarded to StrataPage -------
    in property <string> strata-title-text;
    in property <string> strata-list-title;
    in property <string> strata-empty-text;
    in property <[StrataItem]> strata-items;
    in property <string> strata-delete-text;
    in property <string> strata-in-use-text;
    in property <string> strata-form-section;
    in property <string> strata-label-name;
    in property <string> strata-placeholder-name;
    in property <string> strata-label-description;
    in property <string> strata-placeholder-description;
    in property <string> strata-label-height-min;
    in property <string> strata-placeholder-height-min;
    in property <string> strata-label-height-max;
    in property <string> strata-placeholder-height-max;
    in property <string> strata-label-sort-order;
    in property <string> strata-placeholder-sort-order;
    in property <string> strata-create-button-text;
    in-out property <string> strata-status-text;
    in property <bool> strata-status-is-error: false;
    in-out property <string> new-strata-name;
    in-out property <string> new-strata-description;
    in-out property <string> new-strata-min-height;
    in-out property <string> new-strata-max-height;
    in-out property <string> new-strata-sort-order: "50";
    callback create-strata();
    callback delete-strata(string);

    // ------- Settings page state forwarded to SettingsPage -------
    in property <string> settings-title-text;
    in property <string> settings-current-section;
    in property <string> settings-current-label;
    in property <string> settings-current-value;
    in property <string> settings-edit-section;
    in property <string> settings-backend-kind-label;
    in property <[string]> settings-backend-kind-labels;
    in-out property <int> settings-backend-kind-index: 0;
    in property <string> settings-sqlite-path-label;
    in property <string> settings-sqlite-path-placeholder;
    in-out property <string> settings-sqlite-path;
    in property <string> settings-mariadb-host-label;
    in property <string> settings-mariadb-host-placeholder;
    in-out property <string> settings-mariadb-host;
    in property <string> settings-mariadb-port-label;
    in property <string> settings-mariadb-port-placeholder;
    in-out property <string> settings-mariadb-port: "3306";
    in property <string> settings-mariadb-user-label;
    in property <string> settings-mariadb-user-placeholder;
    in-out property <string> settings-mariadb-user;
    in property <string> settings-mariadb-password-label;
    in property <string> settings-mariadb-password-placeholder;
    in-out property <string> settings-mariadb-password;
    in property <string> settings-mariadb-database-label;
    in property <string> settings-mariadb-database-placeholder;
    in-out property <string> settings-mariadb-database;
    in property <string> settings-test-button;
    in property <string> settings-save-button;
    in property <string> settings-save-migrate-button;
    in property <string> settings-migrate-warning;
    in-out property <string> settings-status-text;
    in property <bool> settings-status-is-error: false;
    callback settings-test-backend(int, string, string, string, string, string, string);
    callback settings-save-backend(int, string, string, string, string, string, string);
    callback settings-save-and-migrate(int, string, string, string, string, string, string);

    // ------- Task Calendar page state -------
    in property <string> task-calendar-title-text;
    in property <string> task-calendar-month-label;
    in property <string> task-calendar-prev-button-text;
    in property <string> task-calendar-next-button-text;
    in property <string> task-calendar-today-button-text;
    in property <string> task-calendar-empty-state-text;
    in property <string> task-calendar-hint-text;
    in property <[string]> task-calendar-weekday-labels;
    in property <[TaskCalendarDay]> task-calendar-days;
    in property <bool> task-calendar-any-tasks;
    callback task-prev-month();
    callback task-next-month();
    callback task-go-today();
    callback task-toggle-completion(string);

    init => {
        // Claim focus for the global shortcut scope at startup so Ctrl+1..6
        // and calendar arrow keys are picked up before any LineEdit grabs
        // focus. When the user clicks into a text input the LineEdit takes
        // focus and global shortcuts pause — clicking outside, or pressing
        // Tab back out, restores them.
        shortcuts.focus();
    }

    shortcuts := FocusScope {
        key-pressed(event) => {
            // Sidebar shortcuts: Ctrl+1..8 mirror the sidebar order.
            if (event.modifiers.control) {
                if (event.text == "1") {
                    root.current-page = "home";
                    root.navigate-home();
                    return accept;
                }
                if (event.text == "2") {
                    root.current-page = "plantings";
                    root.navigate-plantings();
                    return accept;
                }
                if (event.text == "3") {
                    root.current-page = "tasks";
                    root.navigate-tasks();
                    return accept;
                }
                if (event.text == "4") {
                    root.current-page = "cultures";
                    root.navigate-cultures();
                    return accept;
                }
                if (event.text == "5") {
                    root.current-page = "locations";
                    root.navigate-locations();
                    return accept;
                }
                if (event.text == "6") {
                    root.current-page = "calendar";
                    root.navigate-calendar();
                    return accept;
                }
                if (event.text == "7") {
                    root.current-page = "strata";
                    root.navigate-strata();
                    return accept;
                }
                if (event.text == "8") {
                    root.current-page = "settings";
                    root.navigate-settings();
                    return accept;
                }
            }
            // Help shortcut: F1 is the conventional "open the manual"
            // key on every desktop OS — kept as the sole binding now that
            // the Ctrl+N row is filled up with sidebar navigation.
            if (event.text == Key.F1) {
                root.open-manual();
                return accept;
            }
            // Calendar arrows: Left/Right step prev/next month on either of
            // the two month grids (harvest calendar, task calendar).
            if (root.current-page == "calendar") {
                if (event.text == Key.LeftArrow) {
                    root.prev-month();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.next-month();
                    return accept;
                }
            }
            if (root.current-page == "tasks") {
                if (event.text == Key.LeftArrow) {
                    root.task-prev-month();
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.task-next-month();
                    return accept;
                }
            }
            return reject;
        }
    }

    // Auto-clear each status banner ~4 seconds after Rust pushes a message.
    // The Timer's `running` binding tracks the text being non-empty; the
    // trigger clears the text, which stops the timer until the next push.
    Timer {
        interval: 4s;
        running: root.status-text != "";
        triggered => { root.status-text = ""; }
    }
    Timer {
        interval: 4s;
        running: root.harvest-status-text != "";
        triggered => { root.harvest-status-text = ""; }
    }
    Timer {
        interval: 4s;
        running: root.strata-status-text != "";
        triggered => { root.strata-status-text = ""; }
    }
    Timer {
        interval: 6s;     // give the user a beat longer to read migration reports
        running: root.settings-status-text != "";
        triggered => { root.settings-status-text = ""; }
    }

    HorizontalLayout {
        spacing: 0px;

        // ============ Sidebar ============
        Rectangle {
            width: 240px;
            background: Palette.surface;

            // Right border drawn as a thin sibling rectangle so it doesn't
            // require switching the parent Rectangle to a full border.
            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Palette.border;
            }

            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-sm;

                // Logo / brand
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: title-text;
                        color: Palette.primary;
                        font-size: Theme.font-size-h2;
                        font-weight: Theme.font-weight-bold;
                    }
                    Text {
                        text: version-text;
                        color: Palette.text-muted;
                        font-size: Theme.font-size-label;
                    }
                }

                Rectangle { height: Theme.space-md; }

                NavButton {
                    text: nav-home-text;
                    selected: current-page == "home";
                    clicked => { current-page = "home"; navigate-home(); }
                }
                NavButton {
                    text: nav-plantings-text;
                    selected: current-page == "plantings";
                    clicked => { current-page = "plantings"; navigate-plantings(); }
                }
                NavButton {
                    text: nav-tasks-text;
                    selected: current-page == "tasks";
                    clicked => { current-page = "tasks"; navigate-tasks(); }
                }
                NavButton {
                    text: nav-cultures-text;
                    selected: current-page == "cultures";
                    clicked => { current-page = "cultures"; navigate-cultures(); }
                }
                NavButton {
                    text: nav-locations-text;
                    selected: current-page == "locations";
                    clicked => { current-page = "locations"; navigate-locations(); }
                }
                NavButton {
                    text: nav-calendar-text;
                    selected: current-page == "calendar";
                    clicked => { current-page = "calendar"; navigate-calendar(); }
                }
                NavButton {
                    text: nav-strata-text;
                    selected: current-page == "strata";
                    clicked => { current-page = "strata"; navigate-strata(); }
                }
                NavButton {
                    text: nav-settings-text;
                    selected: current-page == "settings";
                    clicked => { current-page = "settings"; navigate-settings(); }
                }
                // Help is an action, not a page — never appears `selected`.
                // Clicking it asks Rust to open the bundled manual PDF with
                // the system's default viewer.
                NavButton {
                    text: nav-help-text;
                    selected: false;
                    clicked => { open-manual(); }
                }

                // Push the language footer to the bottom.
                Rectangle { vertical-stretch: 1; }

                Rectangle { height: 1px; background: Palette.border; }

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Text {
                        text: current-language-tag;
                        color: Palette.text-muted;
                        font-size: Theme.font-size-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    SecondaryButton {
                        text: language-button-text;
                        clicked => { toggle-language(); }
                    }
                }
            }
        }

        // ============ Content ============
        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            // ------- Home -------
            if current-page == "home": HomePage {
                welcome-text: welcome-text;
                section-overview-text: section-overview-text;
                label-strata: label-strata;
                label-families: label-families;
                label-location-kinds: label-location-kinds;
                count-strata: count-strata;
                count-families: count-families;
                count-location-kinds: count-location-kinds;
                section-season-text: section-season-text;
                empty-season-text: empty-season-text;
                gantt-bars: gantt-bars;
                gantt-month-labels: gantt-month-labels;
                gantt-today-day: gantt-today-day;
                row-clicked(pid) => { planting-row-clicked(pid); }
            }

            // ------- Plantings -------
            if current-page == "plantings": PlantingsPage {
                title-text: plantings-title-text;
                empty-state-text: empty-state-text;
                plantings: plantings;
                plants-suffix: plants-suffix;
                section-new-text: section-new-text;
                label-variety: label-variety;
                label-location: label-location;
                label-sown-on: label-sown-on;
                label-established-on: label-established-on;
                label-removal-on: label-removal-on;
                label-area: label-area;
                label-count: label-count;
                placeholder-date: placeholder-date;
                placeholder-removal-date: placeholder-removal-date;
                placeholder-area: placeholder-area;
                placeholder-count: placeholder-count;
                create-button-text: create-button-text;
                variety-labels: variety-labels;
                location-labels: location-labels;
                variety-is-annuals: variety-is-annuals;
                variety-index <=> variety-index;
                location-index <=> location-index;
                sown-on-text <=> sown-on-text;
                established-on-text <=> established-on-text;
                removal-on-text <=> removal-on-text;
                area-text <=> area-text;
                count-text <=> count-text;
                status-text: status-text;
                status-is-error: status-is-error;
                section-gantt-text: section-gantt-text;
                gantt-bars: gantt-bars;
                gantt-month-labels: gantt-month-labels;
                gantt-today-day: gantt-today-day;
                create-planting => { create-planting(); }
