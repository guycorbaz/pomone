// Pomone — root Slint window.
//
// All user-visible text comes in via in-properties so the Rust side can fill
// it from Fluent (single source of truth for translations).
//
// All colours/spacing/typography come from `theme.slint` so screens stay
// visually coherent and a single switch flips light → dark.

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader } from "theme.slint";

// One row of the "overview" card: a label on the left, a numeric value on the right.
component StatRow inherits Rectangle {
    in property <string> label;
    in property <int> value;
    height: 36px;
    HorizontalLayout {
        padding-left: 0px;
        padding-right: 0px;
        spacing: Theme.space-md;
        alignment: stretch;
        Text {
            text: root.label;
            color: Palette.text-primary;
            font-size: Theme.font-size-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Palette.primary;
            font-size: Theme.font-size-numeric;
            font-weight: Theme.font-weight-semibold;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// Thin divider between rows inside a card.
component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
}

export component MainWindow inherits Window {
    title: "Pomone";
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 480px;
    min-height: 360px;
    background: Palette.background;

    // Header / welcome
    in property <string> title-text;
    in property <string> welcome-text;
    in property <string> version-text;
    in property <string> section-overview-text;

    // Stats labels (left column) and values (right column)
    in property <string> label-strata;
    in property <string> label-families;
    in property <string> label-location-kinds;
    in property <int> count-strata;
    in property <int> count-families;
    in property <int> count-location-kinds;

    // Language switcher
    in property <string> language-button-text;
    in property <string> current-language-tag;
    callback toggle-language();
    callback refresh-counts();
    in property <string> refresh-button-text;

    VerticalLayout {
        padding: Theme.space-2xl;
        spacing: Theme.space-xl;

        // Header — app name + version
        HorizontalLayout {
            alignment: stretch;
            spacing: Theme.space-md;

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: title-text;
                    color: Palette.primary;
                    font-size: Theme.font-size-h1;
                    font-weight: Theme.font-weight-bold;
                }
                Text {
                    text: version-text;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-label;
                }
            }
        }

        // Welcome line — secondary text, wraps on narrow widths.
        Text {
            text: welcome-text;
            color: Palette.text-secondary;
            font-size: Theme.font-size-body;
            wrap: word-wrap;
        }

        // Overview card — three labelled counts.
        Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-sm;

                SectionHeader {
                    text: section-overview-text;
                }

                Rectangle { height: Theme.space-xs; }

                StatRow {
                    label: label-strata;
                    value: count-strata;
                }
                Divider { }
                StatRow {
                    label: label-families;
                    value: count-families;
                }
                Divider { }
                StatRow {
                    label: label-location-kinds;
                    value: count-location-kinds;
                }
            }
        }

        // Pushes the action row to the bottom.
        Rectangle { vertical-stretch: 1; }

        // Footer — primary action (refresh) on the left, language switch on the right.
        HorizontalLayout {
            spacing: Theme.space-md;
            alignment: stretch;

            PrimaryButton {
                text: refresh-button-text;
                clicked => {
                    refresh-counts();
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: current-language-tag;
                color: Palette.text-muted;
                font-size: Theme.font-size-label;
                vertical-alignment: center;
            }
            SecondaryButton {
                text: language-button-text;
                clicked => {
                    toggle-language();
                }
            }
        }
    }
}
