// Pomone — root Slint window.
//
// MainWindow is just a router: it owns `current-page` and switches between
// the Home, Plantings and Cultures panes. Every visible string and every list
// model is supplied by Rust through in-properties, keeping translations and
// data in a single Rust-side source of truth.

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader } from "theme.slint";
import { PlantingsPage, PlantingRow } from "plantings.slint";
import { CulturesPage, CropRow, VarietyRow } from "cultures.slint";
import { LocationsPage, LocationItem } from "locations.slint";

// Re-export so the generated Rust types are visible to `main.rs`.
export { PlantingRow, CropRow, VarietyRow, LocationItem }

// One row of the "overview" card on the home page: label on the left, numeric
// value on the right.
component StatRow inherits Rectangle {
    in property <string> label;
    in property <int> value;
    height: 44px;
    HorizontalLayout {
        spacing: Theme.space-md;
        Text {
            text: root.label;
            color: Palette.text-primary;
            font-size: Theme.font-size-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Palette.primary;
            font-size: Theme.font-size-numeric;
            font-weight: Theme.font-weight-semibold;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
}

export component MainWindow inherits Window {
    title: "Pomone";
    preferred-width: 1200px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 560px;
    background: Palette.background;

    // ------- Navigation -------
    in-out property <string> current-page: "home";

    // ------- Home page strings -------
    in property <string> title-text;
    in property <string> welcome-text;
    in property <string> version-text;
    in property <string> section-overview-text;
    in property <string> label-strata;
    in property <string> label-families;
    in property <string> label-location-kinds;
    in property <int> count-strata;
    in property <int> count-families;
    in property <int> count-location-kinds;
    in property <string> language-button-text;
    in property <string> current-language-tag;
    in property <string> refresh-button-text;
    in property <string> plantings-button-text;
    in property <string> cultures-button-text;
    in property <string> locations-button-text;
    callback toggle-language();
    callback refresh-counts();
    callback navigate-plantings();
    callback navigate-cultures();
    callback navigate-locations();

    // ------- Plantings page state forwarded to PlantingsPage -------
    in property <string> plantings-title-text;
    in property <string> back-button-text;
    in property <string> empty-state-text;
    in property <[PlantingRow]> plantings;
    in property <string> section-new-text;
    in property <string> label-variety;
    in property <string> label-location;
    in property <string> label-sown-on;
    in property <string> label-area;
    in property <string> label-count;
    in property <string> placeholder-date;
    in property <string> placeholder-area;
    in property <string> placeholder-count;
    in property <string> create-button-text;
    in property <[string]> variety-labels;
    in property <[string]> location-labels;
    in-out property <int> variety-index: 0;
    in-out property <int> location-index: 0;
    in-out property <string> sown-on-text;
    in-out property <string> area-text: "20";
    in-out property <string> count-text: "20";
    in property <string> status-text;
    in property <bool> status-is-error: false;
    callback create-planting();

    // ------- Cultures page state forwarded to CulturesPage -------
    in property <string> cultures-title-text;
    in property <string> crops-title;
    in property <string> empty-crops-text;
    in property <[CropRow]> crops;
    in-out property <int> selected-crop-index: -1;

    in property <string> new-crop-section;
    in property <string> label-crop-name;
    in property <string> placeholder-crop-name;
    in property <string> label-crop-latin;
    in property <string> placeholder-crop-latin;
    in property <string> label-crop-family;
    in property <string> label-crop-strata;
    in property <[string]> family-labels;
    in property <[string]> strata-labels;
    in-out property <int> family-index: 0;
    in-out property <int> strata-index: 0;
    in-out property <string> new-crop-name;
    in-out property <string> new-crop-latin;
    in property <string> create-crop-button-text;
    callback create-crop();
    callback select-crop(int);

    in property <string> varieties-title;
    in property <string> empty-varieties-text;
    in property <string> no-crop-selected-text;
    in property <[VarietyRow]> varieties;

    in property <string> new-variety-section;
    in property <string> label-variety-name;
    in property <string> placeholder-variety-name;
    in property <string> label-variety-description;
    in property <string> placeholder-variety-description;
    in property <string> label-dtt;
    in property <string> label-dtm;
    in property <string> label-window;
    in property <string> placeholder-dtt;
    in property <string> placeholder-dtm;
    in property <string> placeholder-window;
    in-out property <string> new-variety-name;
    in-out property <string> new-variety-description;
    in-out property <string> new-variety-dtt: "35";
    in-out property <string> new-variety-dtm: "70";
    in-out property <string> new-variety-window: "60";
    in property <string> create-variety-button-text;
    callback create-variety();

    // ------- Locations page state forwarded to LocationsPage -------
    in property <string> locations-title-text;
    in property <string> locations-list-title;
    in property <string> empty-locations-text;
    in property <[LocationItem]> locations;
    in property <string> location-form-section;
    in property <string> label-loc-name;
    in property <string> placeholder-loc-name;
    in property <string> label-loc-kind;
    in property <string> label-loc-area;
    in property <string> placeholder-loc-area;
    in property <string> label-loc-parent;
    in property <string> label-loc-notes;
    in property <string> placeholder-loc-notes;
    in property <[string]> loc-kind-labels;
    in property <[string]> loc-parent-labels;
    in-out property <int> loc-kind-index: 0;
    in-out property <int> loc-parent-index: 0;
    in-out property <string> new-loc-name;
    in-out property <string> new-loc-area: "20";
    in-out property <string> new-loc-notes;
    in property <string> create-loc-button-text;
    callback create-location();

    // ------- Home page -------
    if current-page == "home": home-pane := VerticalLayout {
        padding: Theme.space-2xl;
        spacing: Theme.space-xl;

        HorizontalLayout {
            spacing: Theme.space-md;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: title-text;
                    color: Palette.primary;
                    font-size: Theme.font-size-h1;
                    font-weight: Theme.font-weight-bold;
                }
                Text {
                    text: version-text;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-label;
                }
            }
        }

        Text {
            text: welcome-text;
            color: Palette.text-secondary;
            font-size: Theme.font-size-body;
            wrap: word-wrap;
        }

        Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-sm;

                SectionHeader { text: section-overview-text; }
                Rectangle { height: Theme.space-xs; }

                StatRow { label: label-strata; value: count-strata; }
                Divider { }
                StatRow { label: label-families; value: count-families; }
                Divider { }
                StatRow { label: label-location-kinds; value: count-location-kinds; }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: Theme.space-md;
            alignment: stretch;

            PrimaryButton {
                text: plantings-button-text;
                clicked => { navigate-plantings(); }
            }
            SecondaryButton {
                text: cultures-button-text;
                clicked => { navigate-cultures(); }
            }
            SecondaryButton {
                text: locations-button-text;
                clicked => { navigate-locations(); }
            }
            SecondaryButton {
                text: refresh-button-text;
                clicked => { refresh-counts(); }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: current-language-tag;
                color: Palette.text-muted;
                font-size: Theme.font-size-label;
                vertical-alignment: center;
            }
            SecondaryButton {
                text: language-button-text;
                clicked => { toggle-language(); }
            }
        }
    }

    // ------- Plantings page -------
    if current-page == "plantings": plantings-pane := PlantingsPage {
        title-text: plantings-title-text;
        back-button-text: back-button-text;
        empty-state-text: empty-state-text;
        plantings: plantings;
        section-new-text: section-new-text;
        label-variety: label-variety;
        label-location: label-location;
        label-sown-on: label-sown-on;
        label-area: label-area;
        label-count: label-count;
        placeholder-date: placeholder-date;
        placeholder-area: placeholder-area;
        placeholder-count: placeholder-count;
        create-button-text: create-button-text;
        variety-labels: variety-labels;
        location-labels: location-labels;
        variety-index <=> variety-index;
        location-index <=> location-index;
        sown-on-text <=> sown-on-text;
        area-text <=> area-text;
        count-text <=> count-text;
        status-text: status-text;
        status-is-error: status-is-error;
        back => { current-page = "home"; }
        create-planting => { create-planting(); }
    }

    // ------- Cultures page -------
    if current-page == "cultures": cultures-pane := CulturesPage {
        title-text: cultures-title-text;
        back-button-text: back-button-text;
        crops-title: crops-title;
        empty-crops-text: empty-crops-text;
        crops: crops;
        selected-crop-index <=> selected-crop-index;
        new-crop-section: new-crop-section;
        label-crop-name: label-crop-name;
        placeholder-crop-name: placeholder-crop-name;
        label-crop-latin: label-crop-latin;
        placeholder-crop-latin: placeholder-crop-latin;
        label-family: label-crop-family;
        label-strata: label-crop-strata;
        family-labels: family-labels;
        strata-labels: strata-labels;
        family-index <=> family-index;
        strata-index <=> strata-index;
        new-crop-name <=> new-crop-name;
        new-crop-latin <=> new-crop-latin;
        create-crop-button-text: create-crop-button-text;
        varieties-title: varieties-title;
        empty-varieties-text: empty-varieties-text;
        no-crop-selected-text: no-crop-selected-text;
        varieties: varieties;
        new-variety-section: new-variety-section;
        label-variety-name: label-variety-name;
        placeholder-variety-name: placeholder-variety-name;
        label-variety-description: label-variety-description;
        placeholder-variety-description: placeholder-variety-description;
        label-dtt: label-dtt;
        label-dtm: label-dtm;
        label-window: label-window;
        placeholder-dtt: placeholder-dtt;
        placeholder-dtm: placeholder-dtm;
        placeholder-window: placeholder-window;
        new-variety-name <=> new-variety-name;
        new-variety-description <=> new-variety-description;
        new-variety-dtt <=> new-variety-dtt;
        new-variety-dtm <=> new-variety-dtm;
        new-variety-window <=> new-variety-window;
        create-variety-button-text: create-variety-button-text;
        status-text: status-text;
        status-is-error: status-is-error;
        back => { current-page = "home"; }
        create-crop => { create-crop(); }
        create-variety => { create-variety(); }
        select-crop(idx) => { select-crop(idx); }
    }

    // ------- Locations page -------
    if current-page == "locations": locations-pane := LocationsPage {
        title-text: locations-title-text;
        back-button-text: back-button-text;
        list-title: locations-list-title;
        empty-locations-text: empty-locations-text;
        locations: locations;
        form-section-title: location-form-section;
        label-loc-name: label-loc-name;
        placeholder-loc-name: placeholder-loc-name;
        label-loc-kind: label-loc-kind;
        label-loc-area: label-loc-area;
        placeholder-loc-area: placeholder-loc-area;
        label-loc-parent: label-loc-parent;
        label-loc-notes: label-loc-notes;
        placeholder-loc-notes: placeholder-loc-notes;
        loc-kind-labels: loc-kind-labels;
        loc-parent-labels: loc-parent-labels;
        loc-kind-index <=> loc-kind-index;
        loc-parent-index <=> loc-parent-index;
        new-loc-name <=> new-loc-name;
        new-loc-area <=> new-loc-area;
        new-loc-notes <=> new-loc-notes;
        create-loc-button-text: create-loc-button-text;
        status-text: status-text;
        status-is-error: status-is-error;
        back => { current-page = "home"; }
        create-location => { create-location(); }
    }
}
