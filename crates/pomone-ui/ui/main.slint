                in-use-text: task-types-in-use-text;
                status-text: task-types-status-text;
                status-is-error: task-types-status-is-error;
                types: task-types-items;
                category-labels: task-types-category-labels;
                category-index <=> task-types-category-index;
                is-edit-mode: task-types-is-edit-mode;
                form-name <=> task-types-form-name;
                form-color <=> task-types-form-color;
                form-color-preview: task-types-form-color-preview;
                save => { task-types-save(); }
