                new-harvest-expected <=> new-harvest-expected;
                new-harvest-actual <=> new-harvest-actual;
                new-harvest-notes <=> new-harvest-notes;
                go-back => { detail-go-back(); }
                record-harvest => { record-harvest(); }
            }

            // ------- Cultures -------
            if current-page == "cultures": CulturesPage {
                title-text: cultures-title-text;
                crops-title: crops-title;
                empty-crops-text: empty-crops-text;
