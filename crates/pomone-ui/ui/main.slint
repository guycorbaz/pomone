            }

            // ------- Crop Map -------
            if current-page == "crop-map": CropMapPage {
                title-text: crop-map-title-text;
                hint-text: crop-map-hint-text;
                empty-text: crop-map-empty-text;
                btn-move-text: crop-map-btn-move-text;
                btn-split-text: crop-map-btn-split-text;
                btn-deselect-text: crop-map-btn-deselect-text;
                picker-title: crop-map-picker-title;
                picker-cancel-text: crop-map-picker-cancel-text;
                split-title: crop-map-split-title;
                split-hint: crop-map-split-hint;
                split-part-a-label: crop-map-split-part-a-label;
                split-part-b-label: crop-map-split-part-b-label;
                split-location-label: crop-map-split-location-label;
                split-area-label: crop-map-split-area-label;
                split-count-label: crop-map-split-count-label;
                split-placeholder-area: crop-map-split-placeholder-area;
                split-placeholder-count: crop-map-split-placeholder-count;
                split-confirm-text: crop-map-split-confirm-text;
                split-cancel-text: crop-map-split-cancel-text;
                split-status-text: crop-map-split-status-text;
                split-status-is-error: crop-map-split-status-is-error;
                lanes: crop-map-lanes;
                month-labels: crop-map-month-labels;
                move-target-options: crop-map-move-target-options;
                split-target-labels: crop-map-split-target-labels;
                selected-planting-id <=> crop-map-selected-planting-id;
                move-picker-visible <=> crop-map-move-picker-visible;
                split-form-visible <=> crop-map-split-form-visible;
                split-part-a-location-index <=> crop-map-split-part-a-location-index;
                split-part-b-location-index <=> crop-map-split-part-b-location-index;
                split-part-a-area <=> crop-map-split-part-a-area;
                split-part-b-area <=> crop-map-split-part-b-area;
                split-part-a-count <=> crop-map-split-part-a-count;
                split-part-b-count <=> crop-map-split-part-b-count;
                bar-clicked(pid) => { crop-map-bar-clicked(pid); }
                move-to(pid, lid) => { crop-map-move-to(pid, lid); }
                split-clicked(pid) => { crop-map-split-clicked(pid); }
                split-confirm => { crop-map-split-confirm(); }
                split-cancel => { crop-map-split-cancel(); }
            }

            // ------- Task form (create / edit) -------
            if current-page == "task-form": TaskFormPage {
                is-edit-mode: task-form-is-edit-mode;
                title-new-text: task-form-title-new-text;
                title-edit-text: task-form-title-edit-text;
                label-task-type: task-form-label-task-type;
                label-planting: task-form-label-planting;
                label-planned-on: task-form-label-planned-on;
                label-notes: task-form-label-notes;
                placeholder-date: task-form-placeholder-date;
                placeholder-notes: task-form-placeholder-notes;
                label-completed: task-form-label-completed;
                btn-save-text: task-form-btn-save-text;
                btn-cancel-text: task-form-btn-cancel-text;
                btn-delete-text: task-form-btn-delete-text;
                status-text: task-form-status-text;
                status-is-error: task-form-status-is-error;
                task-type-labels: task-form-type-labels;
                planting-labels: task-form-planting-labels;
                task-type-index <=> task-form-type-index;
                planting-index <=> task-form-planting-index;
                planned-on-text <=> task-form-planned-on-text;
                notes-text <=> task-form-notes-text;
                completed <=> task-form-completed;
                label-recurring: task-form-label-recurring;
                label-recurrence-interval: task-form-label-recurrence-interval;
                placeholder-recurrence-interval: task-form-placeholder-recurrence-interval;
                label-recurrence-unit: task-form-label-recurrence-unit;
                label-recurrence-end-on: task-form-label-recurrence-end-on;
                placeholder-recurrence-end-on: task-form-placeholder-recurrence-end-on;
                hint-recurrence-end-on: task-form-hint-recurrence-end-on;
                recurring-series-badge-text: task-form-recurring-series-badge-text;
                recurrence-unit-labels: task-form-recurrence-unit-labels;
                recurring <=> task-form-recurring;
                recurrence-interval-text <=> task-form-recurrence-interval-text;
                recurrence-unit-index <=> task-form-recurrence-unit-index;
                recurrence-end-on-text <=> task-form-recurrence-end-on-text;
                is-part-of-series: task-form-is-part-of-series;
                save => { task-form-save(); }
                cancel => { task-form-cancel(); }
                delete-task => { task-form-delete(); }
            }

            // ------- Locations -------
            if current-page == "locations": LocationsPage {
                title-text: locations-title-text;
                list-title: locations-list-title;
                empty-locations-text: empty-locations-text;
                locations: locations;
                form-section-title: location-form-section;
                label-loc-name: label-loc-name;
                placeholder-loc-name: placeholder-loc-name;
                label-loc-kind: label-loc-kind;
                label-loc-length: label-loc-length;
                placeholder-loc-length: placeholder-loc-length;
                label-loc-width: label-loc-width;
                placeholder-loc-width: placeholder-loc-width;
                label-loc-parent: label-loc-parent;
                label-loc-notes: label-loc-notes;
                placeholder-loc-notes: placeholder-loc-notes;
                loc-kind-labels: loc-kind-labels;
                loc-parent-labels: loc-parent-labels;
                loc-kind-index <=> loc-kind-index;
                loc-parent-index <=> loc-parent-index;
                new-loc-name <=> new-loc-name;
                new-loc-length <=> new-loc-length;
                new-loc-width <=> new-loc-width;
                new-loc-notes <=> new-loc-notes;
                create-loc-button-text: create-loc-button-text;
                status-text: status-text;
                status-is-error: status-is-error;
                create-location => { create-location(); }
            }
        }
    }

    // ------- Modal confirmation dialog (issue #61) -------
    // Drawn after the focus scope so it overlays every page. The dim backdrop
    // swallows clicks (the user must pick Cancel or Confirm).
    if confirm-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000077;

        TouchArea { } // eat clicks on the backdrop

        Card {
            width: min(420px, parent.width - 80px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface;

            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-md;

                Text {
                    text: confirm-title;
                    color: Palette.text-primary;
                    font-size: Theme.font-size-h2;
                    font-weight: Theme.font-weight-bold;
                }
                Text {
                    text: confirm-message;
                    color: Palette.text-secondary;
                    font-size: Theme.font-size-body;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: end;
                    SecondaryButton {
                        text: confirm-cancel-text;
                        clicked => { confirm-cancelled(); }
                    }
                    PrimaryButton {
                        text: confirm-ok-text;
                        clicked => { confirm-accepted(); }
                    }
                }
            }
        }
    }
}
