// Pomone — Plantings screen.
//
// All user-visible text is fed in from Rust via in-properties (single source
// of truth for translations). The Rust side also owns the list models and
// callbacks (parse the date, build the typed IDs, run the service).

import { Palette, Theme, Card, PrimaryButton, SecondaryButton, SectionHeader, ThemedLineEdit, ThemedComboBox } from "theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Timeline, GanttBar } from "components/timeline.slint";

// Row of the plantings list. Mirrors `pomone_app::PlantingRow` field-for-field;
// the Rust binding converts at the boundary.
export struct PlantingRow {
    id: string,
    variety-label: string,
    // Two-letter crop initials + family colour for the coloured pastille.
    crop-initials: string,
    family-color: color,
    location-label: string,
    schedule-summary: string,
    area-label: string,
    plants-count: int,
    // Life-cycle status (issue #63): localized label + whether it's the
    // default "active" state (the badge is hidden when active to avoid noise).
    status-label: string,
    status-active: bool,
}

// Family-coloured crop pastille — a rounded square with two white initials,
// mirroring Qrop's crop disk. Tinted by botanical family.
component CropPastille inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    width: 30px;
    height: 30px;
    border-radius: Theme.radius-sm;
    background: tint;
    Text {
        text: root.initials;
        color: Palette.text-on-primary;
        font-size: Theme.font-size-label;
        font-weight: Theme.font-weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// A clickable, sortable column header. Shows a ▲/▼ indicator when it is the
// active sort column.
component ColHeader inherits Rectangle {
    in property <string> label;
    in property <string> sort-key;
    in property <string> active-key;
    in property <bool> asc;
    in property <bool> right-align: false;
    in property <int> stretch: 1;
    in property <length> fixed-width: 0px;
    callback sort(string);

    property <bool> active: sort-key == active-key && sort-key != "";
    horizontal-stretch: fixed-width > 0px ? 0 : stretch;
    min-width: fixed-width;
    height: 100%;

    touch := TouchArea {
        mouse-cursor: sort-key != "" ? pointer : default;
        clicked => { if (sort-key != "") { root.sort(sort-key); } }
        HorizontalLayout {
            spacing: 2px;
            alignment: right-align ? end : start;
            Text {
                text: root.label;
                color: root.active ? Palette.primary : Palette.text-secondary;
                font-size: Theme.font-size-label;
                font-weight: Theme.font-weight-semibold;
                vertical-alignment: center;
            }
            if root.active: Text {
                text: root.asc ? "▲" : "▼";
                color: Palette.primary;
                font-size: Theme.font-size-label - 3px;
                vertical-alignment: center;
            }
        }
    }
}

// One dense table row. Clickable: emits `clicked` with the planting id so the
// host can open the detail screen. Hover lifts the surface tone.
component PlantingTableRow inherits Rectangle {
    in property <PlantingRow> entry;
    in property <string> plants-suffix;
    callback clicked(string);
    height: Theme.row-height;
    background: touch.has-hover ? Palette.surface-alt : transparent;
    animate background { duration: Theme.transition-fast; }

    // Bottom divider.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(entry.id); }

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            spacing: Theme.space-md;

            CropPastille {
                initials: entry.crop-initials;
                tint: entry.family-color;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: entry.variety-label;
                color: Palette.text-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-medium;
                vertical-alignment: center;
                horizontal-stretch: 3;
                overflow: elide;
            }
            Text {
                text: entry.location-label;
                color: Palette.text-secondary;
                font-size: Theme.font-size-body;
                vertical-alignment: center;
                horizontal-stretch: 2;
                overflow: elide;
            }
            Text {
                text: entry.schedule-summary;
                color: Palette.text-muted;
                font-size: Theme.font-size-label;
                vertical-alignment: center;
                horizontal-stretch: 3;
                overflow: elide;
            }
            Text {
                text: entry.area-label;
                color: Palette.text-secondary;
                font-size: Theme.font-size-label;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 90px;
            }
            Text {
                text: entry.plants-count;
                color: Palette.text-secondary;
                font-size: Theme.font-size-label;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 64px;
            }
            // Status: a small badge for terminal states, blank when active.
            Rectangle {
                width: 96px;
                HorizontalLayout {
                    alignment: end;
                    if !entry.status-active: Rectangle {
                        background: Palette.surface-alt;
                        border-radius: Theme.radius-pill;
                        border-width: 1px;
                        border-color: Palette.border;
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: Theme.space-sm;
                            padding-right: Theme.space-sm;
                            Text {
                                text: entry.status-label;
                                color: Palette.text-secondary;
                                font-size: Theme.font-size-label - 1px;
                                font-weight: Theme.font-weight-semibold;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component PlantingsPage inherits Rectangle {
    background: Palette.background;

    // Header
    in property <string> title-text;
    in property <string> empty-state-text;

    // List
    in property <[PlantingRow]> plantings;
    in property <string> plants-suffix;
    // Table column headers + current sort state (host owns the sorting).
    in property <string> col-variety;
    in property <string> col-location;
    in property <string> col-schedule;
    in property <string> col-area;
    in property <string> col-plants;
    in property <string> col-status;
    in property <string> sort-column;
    in property <bool> sort-asc: true;
    // Emitted when a sortable header is clicked (carries the column key).
    callback sort(string);

    // Form section
    in property <string> section-new-text;
    in property <string> label-variety;
    in property <string> label-location;
    in property <string> label-sown-on;
    in property <string> label-established-on;
    in property <string> label-removal-on;
    in property <string> label-area;
    in property <string> label-count;
    in property <string> placeholder-date;
    in property <string> placeholder-removal-date;
    in property <string> placeholder-area;
    in property <string> placeholder-count;
    in property <string> create-button-text;
    in property <string> label-strata;
    // Establishment method (annual only): the selector + the alternate date
    // label used when the method is "bought plants".
    in property <string> label-method;
    in property <string> label-planting-date;
    in property <[string]> method-labels;
    in property <[string]> variety-labels;
    in property <[string]> location-labels;
    in property <[string]> strata-labels;
    // Parallel to variety-labels: drives which date fields the form shows.
    in property <[bool]> variety-is-annuals;

    // Form state (read back by Rust on "create" callback)
    in-out property <int> variety-index: 0;
    in-out property <int> location-index: 0;
    in-out property <int> strata-index: 0;
    in-out property <int> method-index: 0;
    in-out property <string> sown-on-text;
    in-out property <string> established-on-text;
    in-out property <string> removal-on-text;
    in-out property <string> area-text: "20";
    in-out property <string> count-text: "20";

    // True if the variety currently selected in the dropdown is annual.
    // Drives whether the form shows the Sowing field (annual) or the
    // Establishment + Expected removal pair (perennial). Defaults to true
    // so the form looks right when no variety exists yet.
    out property <bool> selected-variety-is-annual:
        variety-is-annuals.length > variety-index && variety-index >= 0
        ? variety-is-annuals[variety-index]
        : true;

    // Status line below the form (Rust fills with success or error message)
    in property <string> status-text;
    in property <bool> status-is-error: false;

    // Gantt timeline. Driven from Rust; perennials are skipped on the Rust
    // side because their multi-year span doesn't fit a single-season axis.
    in property <string> section-gantt-text;
    in property <[GanttBar]> gantt-bars;
    in property <[string]> gantt-month-labels;
    in property <int> gantt-today-day;

    callback create-planting();
    // Emitted when the user clicks a row in the list OR a Gantt bar — `id`
    // is the stringified PlantingId from the underlying row.
    callback row-clicked(string);

    VerticalLayout {
        padding: Theme.space-2xl;
        spacing: Theme.space-xl;

        // Screen title.
        Text {
            text: title-text;
            color: Palette.primary;
            font-size: Theme.font-size-h1;
            font-weight: Theme.font-weight-bold;
        }

        // Season Gantt. Sits above the list so it's the first thing users
        // see — Qrop-style planning view. Bar clicks reuse `row-clicked`.
        if gantt-bars.length > 0: Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-sm;

                SectionHeader { text: section-gantt-text; }
                Rectangle { height: Theme.space-xs; }

                Flickable {
                    height: min(gantt-bars.length * 36px + 32px, 360px);
                    viewport-width: 960px;
                    viewport-height: gantt-bars.length * 36px + 32px;

                    Timeline {
                        width: 960px;
                        height: parent.viewport-height;
                        rows: gantt-bars;
                        month-labels: gantt-month-labels;
                        today-day: gantt-today-day;
                        row-clicked(id) => { row-clicked(id); }
                    }
                }
            }
        }

        // List section
        if plantings.length == 0: Card {
            VerticalLayout {
                padding: Theme.space-2xl;
                Text {
                    text: empty-state-text;
                    color: Palette.text-muted;
                    font-size: Theme.font-size-body;
                    horizontal-alignment: center;
                }
            }
        }
        if plantings.length > 0: Card {
            clip: true;
            vertical-stretch: 1;
            VerticalLayout {
                // Sortable header row.
                Rectangle {
                    height: 40px;
                    background: Palette.surface-alt;
                    HorizontalLayout {
                        padding-left: Theme.space-md;
                        padding-right: Theme.space-md;
                        spacing: Theme.space-md;
                        // Spacer above the pastille column.
                        Rectangle { width: 30px; }
                        ColHeader {
                            label: col-variety;
                            sort-key: "variety";
                            stretch: 3;
                            active-key: sort-column;
                            asc: sort-asc;
                            sort(k) => { sort(k); }
                        }
                        ColHeader {
                            label: col-location;
                            sort-key: "location";
                            stretch: 2;
                            active-key: sort-column;
                            asc: sort-asc;
                            sort(k) => { sort(k); }
                        }
                        // Schedule is display-only (not sortable).
                        ColHeader {
                            label: col-schedule;
                            sort-key: "";
                            stretch: 3;
                        }
                        ColHeader {
                            label: col-area;
                            sort-key: "area";
                            fixed-width: 90px;
                            right-align: true;
                            active-key: sort-column;
                            asc: sort-asc;
                            sort(k) => { sort(k); }
                        }
                        ColHeader {
                            label: col-plants;
                            sort-key: "plants";
                            fixed-width: 64px;
                            right-align: true;
                            active-key: sort-column;
                            asc: sort-asc;
                            sort(k) => { sort(k); }
                        }
                        ColHeader {
                            label: col-status;
                            sort-key: "status";
                            fixed-width: 96px;
                            active-key: sort-column;
                            asc: sort-asc;
                            sort(k) => { sort(k); }
                        }
                    }
                }
                list-area := Rectangle {
                    min-height: 160px;
                    preferred-height: 320px;
                    vertical-stretch: 1;
                    ListView {
                        for item in plantings: PlantingTableRow {
                            entry: item;
                            plants-suffix: plants-suffix;
                            width: list-area.width;
                            clicked(pid) => { row-clicked(pid); }
                        }
                    }
                }
            }
        }

        // New-planting form
        Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-md;

                SectionHeader { text: section-new-text; }

                // Row 1 — variety + location
                HorizontalLayout {
                    spacing: Theme.space-md;
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-variety;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedComboBox {
                            model: variety-labels;
                            current-index <=> variety-index;
                            enabled: variety-labels.length > 0;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-location;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedComboBox {
                            model: location-labels;
                            current-index <=> location-index;
                            enabled: location-labels.length > 0;
                        }
                    }
                    // Strata: the vegetation layer this planting occupies
                    // (issue #86 — a cultivar can be grown at different heights).
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-strata;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedComboBox {
                            model: strata-labels;
                            current-index <=> strata-index;
                            enabled: strata-labels.length > 0;
                        }
                    }
                }

                // Row 2 — dates depend on whether the variety is annual.
                // Annual: a single sowing date.
                // Perennial: establishment + expected removal (optional).
                if selected-variety-is-annual: HorizontalLayout {
                    spacing: Theme.space-md;
                    // Establishment method (issue: direct sow / raise+transplant
                    // / bought plants). Index 2 = bought plants → the date is a
                    // planting date, otherwise a sowing date.
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-method;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedComboBox {
                            model: method-labels;
                            current-index <=> method-index;
                            enabled: method-labels.length > 0;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: method-index == 2 ? label-planting-date : label-sown-on;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> sown-on-text;
                            placeholder-text: placeholder-date;
                        }
                    }
                }
                if !selected-variety-is-annual: HorizontalLayout {
                    spacing: Theme.space-md;
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-established-on;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> established-on-text;
                            placeholder-text: placeholder-date;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-removal-on;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> removal-on-text;
                            placeholder-text: placeholder-removal-date;
                        }
                    }
                }
                // Row 3 — area + count (same for both schedule kinds).
                HorizontalLayout {
                    spacing: Theme.space-md;
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-area;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> area-text;
                            placeholder-text: placeholder-area;
                            input-type: decimal;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 1;
                        Text {
                            text: label-count;
                            color: Palette.text-secondary;
                            font-size: Theme.font-size-label;
                        }
                        ThemedLineEdit {
                            text <=> count-text;
                            placeholder-text: placeholder-count;
                            input-type: number;
                        }
                    }
                }

                // Row 3 — submit + status
                HorizontalLayout {
                    spacing: Theme.space-md;
                    alignment: stretch;
                    PrimaryButton {
                        text: create-button-text;
                        enabled: variety-labels.length > 0 && location-labels.length > 0 && strata-labels.length > 0;
                        clicked => { create-planting(); }
                    }
                    Text {
                        text: status-text;
                        color: status-is-error ? Palette.danger : Palette.success;
                        font-size: Theme.font-size-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
